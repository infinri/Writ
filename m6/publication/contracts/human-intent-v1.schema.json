{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:writ:m6:human-intent-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "purpose",
    "scope",
    "operation",
    "expected_revision",
    "publication_version",
    "publication_digest",
    "content_digests"
  ],
  "properties": {
    "purpose": {
      "const": "writ-human-policy-publisher/1"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant",
        "project"
      ],
      "properties": {
        "tenant": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "project": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        }
      }
    },
    "operation": {
      "type": "string",
      "enum": [
        "publish",
        "rollback",
        "retire"
      ]
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "publication_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "publication_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "content_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "acceptance",
        "prerequisites"
      ],
      "properties": {
        "authorization": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "acceptance": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "prerequisites": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}

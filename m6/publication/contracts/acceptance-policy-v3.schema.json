{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:writ:m6:acceptance-policy-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "policy_id",
    "policy_version",
    "criteria"
  ],
  "properties": {
    "version": {
      "const": "writ-acceptance-policy/3"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]{1,9}$"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "required_class",
          "origin",
          "max_waiver_seconds",
          "quorum"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "required_class": {
            "type": "string",
            "enum": [
              "mechanical",
              "evidence",
              "human"
            ]
          },
          "origin": {
            "enum": [
              "project",
              "invariant"
            ]
          },
          "max_waiver_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600
          },
          "quorum": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "eligible"
                ],
                "properties": {
                  "eligible": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 16,
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "evaluator_id",
                        "independence_group"
                      ],
                      "properties": {
                        "evaluator_id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                        },
                        "independence_group": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "if": {
          "properties": {
            "criterion_id": {
              "const": "waiver-review"
            }
          }
        },
        "then": {
          "properties": {
            "origin": {
              "const": "project"
            }
          }
        },
        "else": {
          "properties": {
            "origin": {
              "const": "invariant"
            },
            "max_waiver_seconds": {
              "const": 0
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "quorum": {
                  "type": "object"
                }
              }
            },
            "then": {
              "properties": {
                "required_class": {
                  "enum": [
                    "mechanical",
                    "evidence"
                  ]
                },
                "max_waiver_seconds": {
                  "const": 0
                }
              }
            }
          }
        ]
      },
      "maxItems": 64,
      "contains": {
        "properties": {
          "quorum": {
            "type": "object"
          }
        }
      },
      "minContains": 0,
      "maxContains": 16
    }
  }
}

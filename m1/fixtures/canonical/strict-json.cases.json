  },
  {
   "id": "cj-31-65-objects-scalar",
   "nest": {
    "pattern": "object",
    "count": 65,
    "leaf": "0"
   },
   "rationale": "NEW (D-018): innermost member at depth 65",
   "error": "DEPTH_EXCEEDED"
  },
  {
   "id": "cj-32-64-mixed-scalar",
   "nest": {
    "pattern": "alternate",
    "count": 64,
    "leaf": "0"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/contracts/v2/artifact.schema.json",
  "title": "Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "artifact_id",
    "tenant_id",
    "project_id",
    "task_id",
    "artifact_type",
    "content_ref",
    "provenance_refs",
    "status"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "description": "Project scope; an artifact is evaluated and signed off only within this tenant, project and task (SR-12)"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "minLength": 1
    },
    "content_ref": {
      "type": "string",
      "minLength": 1
    },
    "schema_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "draft",
        "complete",
        "incomplete",
        "rejected"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/contracts/v2/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "evidence_id",
    "tenant_id",
    "project_id",
    "task_id",
    "source_ref",
    "claim_ids",
    "observed_at",
    "verification_status"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "description": "Project scope; evidence and its sources are visible only within this tenant and project (SR-05)"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "retrieval_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_status": {
      "enum": [
        "verified",
        "corroborated",
        "unverified",
        "contradicted",
        "expired"
      ]
    },
    "confidence_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "citation_locator": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "uniqueItems": true,
      "description": "Evidence requirement kinds this item claims to satisfy; a pack evaluator verifies each claim"
    },
    "stance": {
      "enum": [
        "supports",
        "contradicts",
        "context"
      ],
      "description": "Relationship to claim_ids; contradicts records counterevidence"
    },
    "source_published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "quoted_excerpt": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000,
      "description": "Verbatim source text; evidence evaluators check it against the resolved source"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/contracts/v2/taskspec.schema.json",
  "title": "TaskSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "tenant_id",
    "project_id",
    "pack_id",
    "task_type",
    "goal",
    "inputs",
    "required_artifacts",
    "evidence_requirements",
    "limits"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object"
    },
    "required_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "rubric_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "required": [
        "max_duration_seconds"
      ],
      "properties": {
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_model_calls": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "workflow_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "principal_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

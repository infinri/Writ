{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/contracts/v2/action-request.schema.json",
  "title": "Writ V2 ActionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "trace_id",
    "tenant_id",
    "principal",
    "project_id",
    "session_id",
    "idempotency_key",
    "action"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "principal": {
      "type": "object",
      "required": [
        "id",
        "verified_by",
        "authn_method"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "verified_by": {
          "type": "string",
          "minLength": 1,
          "description": "Trusted adapter identity origin; client-supplied value is NOT authentication"
        },
        "authn_method": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expected_state_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "policy_bundle_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "deadline_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "resource",
        "action_digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "canonical_resource_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "action_digest": {
          "type": "string",
          "minLength": 16
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        },
        "requested_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/contracts/v2/modelevent.schema.json",
  "title": "ModelEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "event_id",
    "sequence",
    "kind"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "enum": [
        "message_delta",
        "tool_call_proposal",
        "structured_output",
        "usage",
        "completed",
        "provider_error"
      ]
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "call": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "call_id",
        "name",
        "arguments_json"
      ],
      "properties": {
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "arguments_json": {
          "type": "string"
        }
      }
    },
    "structured_output": {
      "type": [
        "object",
        "null"
      ]
    },
    "usage": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "finish_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "retryable": {
      "type": [
        "boolean",
        "null"
      ]
    }
  }
}

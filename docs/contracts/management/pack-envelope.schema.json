{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/contracts/management/v1/pack-envelope.schema.json",
  "title": "Scoped declarative Capability Pack signature envelope",
  "description": "Signature is Ed25519 over the pack-specific purpose, NUL and canonical UTF-8 payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload",
    "signature"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "scope",
        "compatibility",
        "key_id",
        "manifest",
        "contracts",
        "rubrics"
      ],
      "properties": {
        "purpose": {
          "const": "writ-capability-pack-signature/1"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tenant",
            "project"
          ],
          "properties": {
            "tenant": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$"
            },
            "project": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$"
            }
          }
        },
        "compatibility": {
          "const": "2.0"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "manifest": {
          "$ref": "https://writ.dev/contracts/v2/capabilitypack.schema.json"
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "digest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192
              },
              "version": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]{0,9})\\.(?:0|[1-9][0-9]{0,9})\\.(?:0|[1-9][0-9]{0,9})$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "minItems": 1,
          "maxItems": 16
        },
        "rubrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "binding",
              "entry_digest"
            ],
            "properties": {
              "binding": {
                "$ref": "https://writ.dev/contracts/proposed/pack-rubric-binding.schema.json"
              },
              "entry_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "minItems": 0,
          "maxItems": 16
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  }
}

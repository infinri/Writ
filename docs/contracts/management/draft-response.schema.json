{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/contracts/management/v1/response.schema.json",
  "title": "Writ /manage/v1 policy management response",
  "$defs": {
    "pointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "digest",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "revision"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              }
            }
          ]
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "pointer"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "pointer": {
          "$ref": "#/$defs/pointer"
        }
      }
    },
    "case": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "decision": {
      "$ref": "https://writ.dev/contracts/v2/decision.schema.json"
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "audit_id"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "audit_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          ]
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versions",
        "next"
      ],
      "properties": {
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/version"
          },
          "maxItems": 50
        },
        "next": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compilable",
        "offline_proven",
        "deployed_enforcement",
        "runtime_authority",
        "diagnostics"
      ],
      "properties": {
        "compilable": {
          "type": "boolean"
        },
        "offline_proven": {
          "type": "boolean"
        },
        "deployed_enforcement": {
          "const": "UNVERIFIED"
        },
        "runtime_authority": {
          "const": false
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_authority",
        "cases"
      ],
      "properties": {
        "runtime_authority": {
          "const": false
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case",
              "decision"
            ],
            "properties": {
              "case": {
                "$ref": "#/$defs/case"
              },
              "decision": {
                "$ref": "#/$defs/decision"
              }
            }
          },
          "maxItems": 16
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_authority",
        "structure",
        "cases"
      ],
      "properties": {
        "runtime_authority": {
          "const": false
        },
        "structure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pointer"
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case",
              "changed",
              "before",
              "after"
            ],
            "properties": {
              "case": {
                "$ref": "#/$defs/case"
              },
              "changed": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/pointer"
                }
              },
              "before": {
                "$ref": "#/$defs/decision"
              },
              "after": {
                "$ref": "#/$defs/decision"
              }
            }
          },
          "maxItems": 16
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "pointer"
      ],
      "properties": {
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "UNAUTHORIZED",
            "NOT_FOUND",
            "REVISION_CONFLICT",
            "IDEMPOTENCY_CONFLICT",
            "LIMIT_EXCEEDED",
            "UNAVAILABLE",
            "INVALID_POLICY"
          ]
        },
        "message": {
          "type": "string"
        },
        "pointer": {
          "$ref": "#/$defs/pointer"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "publication_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "scope",
        "publisher",
        "draft",
        "draft_digest",
        "draft_head_revision",
        "proof_digest",
        "idempotency_key_digest",
        "self_publication_acknowledged"
      ],
      "properties": {
        "version": {
          "const": "writ-managed-publication-context/1"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tenant",
            "project"
          ],
          "properties": {
            "tenant": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            "project": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            }
          }
        },
        "publisher": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "draft": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "draft_digest": {
          "$ref": "#/$defs/digest"
        },
        "draft_head_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "proof_digest": {
          "$ref": "#/$defs/digest"
        },
        "idempotency_key_digest": {
          "$ref": "#/$defs/digest"
        },
        "self_publication_acknowledged": {
          "type": "boolean"
        }
      }
    },
    "publication_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "intent_digest",
        "context",
        "revision",
        "publication_version"
      ],
      "properties": {
        "intent": {
          "$ref": "urn:writ:m6:human-intent-v1"
        },
        "intent_digest": {
          "$ref": "#/$defs/digest"
        },
        "context": {
          "$ref": "#/$defs/publication_context"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "publication_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999999
        }
      }
    },
    "publication_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "publication_version",
        "audit_id",
        "intent_digest"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "publication_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999999
        },
        "audit_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "intent_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "publication_history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "next",
        "selected"
      ],
      "properties": {
        "events": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "revision",
              "publication_version",
              "audit_id",
              "operation",
              "publication_digest",
              "intent_digest",
              "human",
              "at",
              "context"
            ],
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "publication_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999999999
              },
              "audit_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "operation": {
                "enum": [
                  "publish",
                  "rollback",
                  "retire"
                ]
              },
              "publication_digest": {
                "$ref": "#/$defs/digest"
              },
              "intent_digest": {
                "$ref": "#/$defs/digest"
              },
              "human": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "context": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/publication_context"
                  }
                ]
              }
            }
          }
        },
        "next": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          ]
        },
        "selected": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "revision",
                "publication_version",
                "audit_id",
                "verified"
              ],
              "properties": {
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "publication_version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999999999
                },
                "audit_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "verified": {
                  "type": "boolean"
                }
              }
            }
          ]
        }
      }
    },
    "evaluatorReceipt": {
      "type": "object",
      "required": [
        "revision",
        "sequence",
        "evaluator_id",
        "status",
        "intent_digest",
        "entry_digest",
        "management_correlation"
      ],
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "evaluator_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "intent_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "entry_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "management_correlation": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evaluatorHistory": {
      "type": "object",
      "required": [
        "revision",
        "entry",
        "runner_key_revoked",
        "history",
        "next"
      ],
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "entry": {
          "oneOf": [
            {
              "$ref": "https://writ.dev/contracts/proposed/evaluator-registry-entry.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "runner_key_revoked": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "history": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/evaluatorReceipt"
          }
        },
        "next": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evaluatorPreview": {
      "type": "object",
      "required": [
        "intent_digest",
        "intent"
      ],
      "additionalProperties": false,
      "properties": {
        "intent_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "intent": {
          "type": "object",
          "required": [
            "purpose",
            "operation",
            "expected_revision",
            "mutation"
          ],
          "additionalProperties": false,
          "properties": {
            "purpose": {
              "const": "writ-human-evaluator-publisher/1"
            },
            "operation": {
              "enum": [
                "publish",
                "revoke"
              ]
            },
            "expected_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "mutation": {
              "oneOf": [
                {
                  "$ref": "https://writ.dev/contracts/proposed/evaluator-registry-entry.schema.json"
                },
                {
                  "type": "object",
                  "required": [
                    "tenant_id",
                    "project_id",
                    "evaluator_id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "tenant_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "project_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "evaluator_id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "waiverReceipt": {
      "type": "object",
      "required": [
        "disposition",
        "result",
        "context",
        "approver_issuer",
        "approver_subject",
        "challenge_id",
        "recorded_at",
        "ledger_sequence"
      ],
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "const": "historical_receipt"
        },
        "result": {
          "const": "waived"
        },
        "context": {
          "$ref": "urn:writ:m6:waiver-context-v1"
        },
        "approver_issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "approver_subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "challenge_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "ledger_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "waiverRequest": {
      "type": "object",
      "required": [
        "waiver_id",
        "context"
      ],
      "additionalProperties": false,
      "properties": {
        "waiver_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "context": {
          "$ref": "urn:writ:m6:waiver-context-v1"
        }
      }
    },
    "waiverInspection": {
      "type": "object",
      "required": [
        "waiver_id",
        "context",
        "historical_receipt"
      ],
      "additionalProperties": false,
      "properties": {
        "waiver_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "context": {
          "$ref": "urn:writ:m6:waiver-context-v1"
        },
        "historical_receipt": {
          "oneOf": [
            {
              "$ref": "#/$defs/waiverReceipt"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "waiverValidation": {
      "type": "object",
      "required": [
        "waiver_id",
        "context",
        "result",
        "currently_valid"
      ],
      "additionalProperties": false,
      "properties": {
        "waiver_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "context": {
          "$ref": "urn:writ:m6:waiver-context-v1"
        },
        "result": {
          "const": "waived"
        },
        "currently_valid": {
          "const": true
        }
      }
    },
    "waiverChallenge": {
      "type": "object",
      "required": [
        "waiver_id",
        "context",
        "challenge_id",
        "challenge_expires_at",
        "client_options_hex"
      ],
      "additionalProperties": false,
      "properties": {
        "waiver_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "context": {
          "$ref": "urn:writ:m6:waiver-context-v1"
        },
        "challenge_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "challenge_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "client_options_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "ok",
        "result"
      ],
      "properties": {
        "version": {
          "const": "/manage/v1"
        },
        "ok": {
          "const": true
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/mutation"
            },
            {
              "$ref": "#/$defs/version"
            },
            {
              "$ref": "#/$defs/history"
            },
            {
              "$ref": "#/$defs/validation"
            },
            {
              "$ref": "#/$defs/simulation"
            },
            {
              "$ref": "#/$defs/comparison"
            },
            {
              "$ref": "#/$defs/publication_preview"
            },
            {
              "$ref": "#/$defs/publication_receipt"
            },
            {
              "$ref": "#/$defs/publication_history"
            },
            {
              "$ref": "#/$defs/evaluatorReceipt"
            },
            {
              "$ref": "#/$defs/evaluatorHistory"
            },
            {
              "$ref": "#/$defs/evaluatorPreview"
            },
            {
              "$ref": "#/$defs/waiverReceipt"
            },
            {
              "$ref": "#/$defs/waiverRequest"
            },
            {
              "$ref": "#/$defs/waiverInspection"
            },
            {
              "$ref": "#/$defs/waiverValidation"
            },
            {
              "$ref": "#/$defs/waiverChallenge"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "ok",
        "error"
      ],
      "properties": {
        "version": {
          "const": "/manage/v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    }
  ]
}

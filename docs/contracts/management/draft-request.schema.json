{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/contracts/management/v1/request.schema.json",
  "title": "Writ /manage/v1 policy management request",
  "$defs": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant",
        "project"
      ],
      "properties": {
        "tenant": {
          "$ref": "#/$defs/label"
        },
        "project": {
          "$ref": "#/$defs/label"
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/label"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "candidate": {
      "type": "object",
      "description": "Unsigned candidate. The boundary enforces 32768 canonical UTF-8 bytes."
    },
    "corpus": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "resource"
        ],
        "properties": {
          "kind": {
            "enum": [
              "synthetic.inspect",
              "synthetic.unknown"
            ]
          },
          "resource": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^synthetic:"
          }
        }
      },
      "maxItems": 16,
      "minItems": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "priorRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "presentation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "description": "Opaque purpose-specific human presentation. The application also enforces its byte limit."
    }
  },

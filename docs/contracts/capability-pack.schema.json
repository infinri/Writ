{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/contracts/v2/capabilitypack.schema.json",
  "title": "CapabilityPack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "pack_id",
    "version",
    "publisher",
    "domain",
    "task_types",
    "workflows",
    "tool_capabilities",
    "artifacts",
    "evaluators",
    "memory",
    "limits"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "signature_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "supported_modes": {
      "type": "array",
      "items": {
        "enum": [
          "external_host",
          "managed_agent"
        ]
      },
      "uniqueItems": true
    },
    "required_model_features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tool_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "workflow_id",
          "task_type",
          "steps"
        ],
        "properties": {
          "workflow_id": {
            "type": "string",
            "minLength": 1
          },
          "task_type": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "human_gates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_type",
          "schema_ref"
        ],
        "properties": {
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "schema_ref": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string"
          }
        }
      }
    },
    "evaluators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evaluator_id",
          "kind",
          "rubric_version"
        ],
        "properties": {
          "evaluator_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "mechanical",
              "evidence",
              "model_assisted",
              "human"
            ]
          },
          "rubric_version": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "required": [
        "read_types",
        "write_types",
        "retention_class"
      ],
      "properties": {
        "read_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "write_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "retention_class": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "max_tool_calls",
        "max_duration_seconds"
      ],
      "properties": {
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/contracts/v2/modelrequest.schema.json",
  "title": "ModelRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "trace_id",
    "tenant_id",
    "project_id",
    "model",
    "messages",
    "budget"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "model_id"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "required_features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "parts"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "developer",
              "user",
              "assistant",
              "tool"
            ]
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "text",
                    "image_ref",
                    "audio_ref",
                    "tool_result"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                },
                "media_type": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "tool_descriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "input_schema_ref"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "input_schema_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "output_schema_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "privacy_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "budget": {
      "type": "object",
      "required": [
        "max_output_tokens"
      ],
      "properties": {
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "deadline_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}

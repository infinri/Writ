{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/contracts/proposed/evaluation-record-scope.schema.json",
  "title": "EvaluationRecord scope binding (PROPOSED amendment of evaluation-record.schema.json, M3-06, D-033; SUPERSEDED for the authorization path by D-038 item 1)",
  "description": "SUPERSEDED for the authorization path (D-038 item 1, OQ-13 option A): this document is not ingested, has no trusted source, key or consumer, and was never ingested. The authoritative evaluation data are the evaluations inside the authenticated AcceptanceRecord (authenticated-acceptance-record-1.schema.json), with their verified runner attestations and the current registry entries. Kept as history and structural reference only; see the enforcement map in docs/implementation/M3-ACCEPTANCE-CONTRACTS.md. A diagnostic projection, if any, is non-authoritative and never invents issued_at, trust classes, statuses or modes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptance_policy_bundle_sha",
    "acceptance_policy_id",
    "acceptance_policy_version",
    "acceptance_record_id",
    "artifact_digest",
    "artifact_snapshot_id",
    "canonical_target",
    "contract_version",
    "criterion_id",
    "environment_digest",
    "evaluation_id",
    "evaluator_id",
    "evaluator_trust",
    "evaluator_version",
    "evidence_digests",
    "fresh_until",
    "implementation_digest",
    "issued_at",
    "mode",
    "project_id",
    "registry_revision",
    "state_revision",
    "status",
    "task_id",
    "tenant_id",
    "transition",
    "workflow_id"
  ],
  "properties": {
    "contract_version": {
      "const": "evaluation-record-scope/1"
    },
    "evaluation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_state",
        "to_state"
      ],
      "properties": {
        "from_state": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "to_state": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      }
    },
    "artifact_snapshot_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "canonical_target": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9_-]{0,63}/[a-z0-9][a-z0-9_-]{0,63}(/(?!\\.\\.?(/|$))[A-Za-z0-9._-]+)*$",
      "description": "Structural only: no empty, . or .. segment. Every trusted ingestion path also checks, in broker::contracts, that it is a kernel canonical resource id equal to workflow:<tenant_id>/<project_id>/<workflow_id> of the same document."
    },
    "acceptance_policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "acceptance_policy_version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$"
    },
    "acceptance_policy_bundle_sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "acceptance_record_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "criterion_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "evaluator_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "evaluator_version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$"
    },
    "implementation_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "registry_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "evaluator_trust": {
      "enum": [
        "M",
        "E",
        "MA",
        "H"
      ]
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "unknown",
        "stale"
      ]
    },
    "attestation_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "evidence_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "fresh_until": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "mode": {
      "enum": [
        "governed",
        "advisory"
      ],
      "description": "INV-39: advisory records never satisfy a protected transition."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evaluator_trust": {
            "const": "M"
          }
        }
      },
      "then": {
        "required": [
          "attestation_ref"
        ]
      }
    }
  ]
}

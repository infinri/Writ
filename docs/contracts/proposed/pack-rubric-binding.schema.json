{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/contracts/proposed/pack-rubric-binding.schema.json",
  "title": "Pack rubric binding (D-052)",
  "description": "A pack proposal checked against a trusted registry entry. This document carries no evaluator, policy or key authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "pack_id",
    "pack_version",
    "rubric_version",
    "evaluator_version",
    "rubric_id",
    "evaluator_id",
    "tenant_id",
    "project_id",
    "class",
    "registry_revision",
    "criteria"
  ],
  "properties": {
    "contract_version": {
      "const": "pack-rubric-binding/1"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "pack_version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$"
    },
    "rubric_version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$"
    },
    "evaluator_version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$"
    },
    "rubric_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "evaluator_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "class": {
      "enum": [
        "mechanical",
        "evidence",
        "human",
        "model_assisted"
      ]
    },
    "registry_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    }
  }
}

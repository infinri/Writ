{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/contracts/proposed/runner-attestation.schema.json",
  "title": "RunnerAttestation (PROPOSED, M3-06, D-033)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptance_policy_bundle_sha",
    "acceptance_policy_id",
    "acceptance_policy_version",
    "acceptance_record_id",
    "artifact_digest",
    "artifact_snapshot_id",
    "attestation_id",
    "auth",
    "canonical_target",
    "command_digest",
    "command_id",
    "contract_version",
    "criterion_id",
    "environment_digest",
    "evaluator_id",
    "evaluator_version",
    "evidence_digests",
    "exit_status",
    "finished_at",
    "fresh_until",
    "implementation_digest",
    "input_digests",
    "output_digest",
    "project_id",
    "purpose",
    "registry_revision",
    "started_at",
    "state_revision",
    "task_id",
    "tenant_id",
    "transition",
    "workflow_id"
  ],
  "properties": {
    "contract_version": {
      "const": "runner-attestation/1"
    },
    "purpose": {
      "const": "writ.runner-attestation.v1",
      "description": "Domain separation: part of the authenticated bytes."
    },
    "attestation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_state",
        "to_state"
      ],
      "properties": {
        "from_state": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "to_state": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      }
    },
    "artifact_snapshot_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "canonical_target": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9_-]{0,63}/[a-z0-9][a-z0-9_-]{0,63}(/[A-Za-z0-9._-]+)*$"
    },
    "acceptance_policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "acceptance_policy_version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$"
    },
    "acceptance_policy_bundle_sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "acceptance_record_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "criterion_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "evaluator_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "evaluator_version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$"
    },
    "implementation_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "registry_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "command_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "command_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "exit_status": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "output_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "finished_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "fresh_until": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "key_id",
        "mac"
      ],
      "properties": {
        "alg": {
          "enum": [
            "hmac-sha256"
          ],
          "description": "Algorithm policy: closed list; an unknown algorithm fails closed. HMAC is a MAC (shared key), not a public-key signature."
        },
        "key_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "mac": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hex HMAC-SHA256 tag over the authenticated bytes defined in M3-ACCEPTANCE-CONTRACTS.md."
        }
      }
    }
  }
}

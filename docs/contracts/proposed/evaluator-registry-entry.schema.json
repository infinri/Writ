{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/contracts/proposed/evaluator-registry-entry.schema.json",
  "title": "EvaluatorRegistryEntry (PROPOSED, M3-06, D-033)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation",
    "class",
    "contract_version",
    "criteria",
    "environment_digest",
    "evaluator_id",
    "evaluator_version",
    "implementation_digest",
    "owner",
    "published_at",
    "publisher",
    "registry_revision",
    "scope",
    "status",
    "trust"
  ],
  "properties": {
    "contract_version": {
      "const": "evaluator-registry-entry/1"
    },
    "evaluator_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "evaluator_version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$"
    },
    "class": {
      "enum": [
        "mechanical",
        "evidence",
        "model_assisted",
        "human"
      ]
    },
    "trust": {
      "enum": [
        "M",
        "E",
        "MA",
        "H"
      ]
    },
    "implementation_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_digest",
        "command_id"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "command_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "description": "Registered command identity and digest (required for class mechanical; the attestation's command must equal it)."
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "key_id"
      ],
      "properties": {
        "alg": {
          "enum": [
            "hmac-sha256"
          ],
          "description": "Algorithm policy: closed list; an unknown algorithm fails closed. HMAC is a MAC (shared key), not a public-key signature."
        },
        "key_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "tenant_id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        }
      }
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "publisher": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "published_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "registry_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "enum": [
        "active",
        "revoked"
      ]
    },
    "revoked_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "class": {
            "const": "mechanical"
          }
        }
      },
      "then": {
        "required": [
          "command"
        ],
        "properties": {
          "trust": {
            "const": "M"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "class": {
            "const": "evidence"
          }
        }
      },
      "then": {
        "properties": {
          "trust": {
            "const": "E"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "class": {
            "const": "model_assisted"
          }
        }
      },
      "then": {
        "properties": {
          "trust": {
            "const": "MA"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "class": {
            "const": "human"
          }
        }
      },
      "then": {
        "properties": {
          "trust": {
            "const": "H"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "revoked"
          }
        }
      },
      "then": {
        "required": [
          "revoked_at"
        ]
      },
      "else": {
        "not": {
          "required": [
            "revoked_at"
          ]
        }
      }
    }
  ]
}

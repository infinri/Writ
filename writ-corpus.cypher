CREATE (:Abstraction {summary: 'List endpoints require pagination with a maximum page size. Unbounded result sets are violations. Pagination is parameterized (limit/offset, cursor, or page/per_page); the default page size is small (10-25); the maximum is bounded (100-200).', abstraction_id: 'ABS-API-DESIGN-028', project: 'writ', compression_ratio: 5.53, rule_count: 5, _dump_id: 'ABS-API-DESIGN-028'});
CREATE (:Abstraction {summary: 'PUT and DELETE are idempotent: calling the same endpoint twice produces the same final state. PUT replaces; DELETE removes (deleting an already-deleted resource is not an error). Repeated calls do not produce duplicate side effects.', abstraction_id: 'ABS-API-DESIGN-052', project: 'writ', compression_ratio: 4.87, rule_count: 4, _dump_id: 'ABS-API-DESIGN-052'});
CREATE (:Abstraction {summary: 'Breaking changes (removed field, renamed field, changed type, removed endpoint, narrowed accepted input) are versioned. Silent contract changes are violations: the old version stays usable until clients migrate.', abstraction_id: 'ABS-API-DESIGN-053', project: 'writ', compression_ratio: 2.62, rule_count: 2, _dump_id: 'ABS-API-DESIGN-053'});
CREATE (:Abstraction {summary: 'Error messages are actionable: they tell the caller what to fix, not just what failed. \'Invalid input\' is a violation; \'Field `email` must be a valid email address\' is the structure.', abstraction_id: 'ABS-API-DESIGN-058', project: 'writ', compression_ratio: 2.58, rule_count: 2, _dump_id: 'ABS-API-DESIGN-058'});
CREATE (:Abstraction {summary: 'API request/response schemas are documented via OpenAPI, JSON Schema, GraphQL SDL, or framework-native equivalent. The documentation is generated from the source of truth (Pydantic models, TypeScript types, etc.), not hand-written.', abstraction_id: 'ABS-API-DESIGN-059', project: 'writ', compression_ratio: 2.44, rule_count: 2, _dump_id: 'ABS-API-DESIGN-059'});
CREATE (:Abstraction {summary: 'Error responses follow a consistent schema: error code (machine-readable), message (human-readable), and field-level details where applicable. The schema is documented and applied across every endpoint.', abstraction_id: 'ABS-API-DESIGN-060', project: 'writ', compression_ratio: 4.11, rule_count: 3, _dump_id: 'ABS-API-DESIGN-060'});
CREATE (:Abstraction {summary: 'A single state-management pattern (Redux, Zustand, MobX, React Context, Vuex, Pinia, NgRx) is used per project. Mixing two patterns scatters state across incompatible mental models. The choice is documented and consistent.', abstraction_id: 'ABS-ARCHITECTURE-002', project: 'writ', compression_ratio: 2.53, rule_count: 2, _dump_id: 'ABS-ARCHITECTURE-002'});
CREATE (:Abstraction {summary: 'Configuration supports environment-based overrides without code changes. Defaults live in code; per-environment values come from env vars, config files, or a secrets manager. New deployment targets do not require code edits.', abstraction_id: 'ABS-ARCHITECTURE-020', project: 'writ', compression_ratio: 5.26, rule_count: 4, _dump_id: 'ABS-ARCHITECTURE-020'});
CREATE (:Abstraction {summary: 'Feature flags have an explicit expiration date and a documented cleanup plan (who removes the flag, when, and what the cleanup looks like). Permanent feature flags are violations: they accumulate as conditional spaghetti.', abstraction_id: 'ABS-ARCHITECTURE-021', project: 'writ', compression_ratio: 2.27, rule_count: 2, _dump_id: 'ABS-ARCHITECTURE-021'});
CREATE (:Abstraction {summary: 'Data access is separated from business rules via a repository or DAO layer. Services depend on repository interfaces; ORM queries are not inlined into business logic.', abstraction_id: 'ABS-ARCHITECTURE-022', project: 'writ', compression_ratio: 7.28, rule_count: 4, _dump_id: 'ABS-ARCHITECTURE-022'});
CREATE (:Abstraction {summary: 'Domain models have no framework imports. Django ORM Model, SQLAlchemy Base, Spring @Entity, Active Record annotations are framework concerns; the domain model is plain data + behavior. Framework types are converted at boundaries.', abstraction_id: 'ABS-ARCHITECTURE-035', project: 'writ', compression_ratio: 2.45, rule_count: 2, _dump_id: 'ABS-ARCHITECTURE-035'});
CREATE (:Abstraction {summary: 'Third-party library usage is concentrated in adapter modules. Imports of the library are confined; the rest of the codebase imports the adapter. Swapping the library affects one module, not the codebase.', abstraction_id: 'ABS-ARCHITECTURE-040', project: 'writ', compression_ratio: 3.02, rule_count: 2, _dump_id: 'ABS-ARCHITECTURE-040'});
CREATE (:Abstraction {summary: 'Interfaces contain only methods that all their consumers use. A \'fat interface\' that some consumers ignore signals the interface should be split into smaller cohesive interfaces.', abstraction_id: 'ABS-ARCHITECTURE-043', project: 'writ', compression_ratio: 5.17, rule_count: 3, _dump_id: 'ABS-ARCHITECTURE-043'});
CREATE (:Abstraction {summary: 'Subclasses or implementations do not weaken preconditions (require less than the parent) or strengthen postconditions (return less than the parent guarantees). A consumer of the parent type works correctly with any subclass.', abstraction_id: 'ABS-ARCHITECTURE-048', project: 'writ', compression_ratio: 2.63, rule_count: 2, _dump_id: 'ABS-ARCHITECTURE-048'});
CREATE (:Abstraction {summary: 'Database migrations are backwards-compatible across the deployment window: old code can run against the new schema until the deploy completes. Destructive changes (drop column, rename column) are split into multiple deploys: 1) deploy code that stops using the column; 2) drop in a later deploy.', abstraction_id: 'ABS-ARCHITECTURE-054', project: 'writ', compression_ratio: 2.99, rule_count: 3, _dump_id: 'ABS-ARCHITECTURE-054'});
CREATE (:Abstraction {summary: 'Comments explain WHY the code is the way it is (constraint, hidden invariant, surprising business rule, workaround for a known bug). Comments that restate WHAT the next line does in natural language are deleted or rewritten to add intent.', abstraction_id: 'ABS-CODE-QUALITY-006', project: 'writ', compression_ratio: 3.85, rule_count: 3, _dump_id: 'ABS-CODE-QUALITY-006'});
CREATE (:Abstraction {summary: 'Commented-out code is never committed. Version control is the history; comments are not. Removed code is removed entirely; if it might be needed later, that future-self can recover it from git.', abstraction_id: 'ABS-CODE-QUALITY-009', project: 'writ', compression_ratio: 2.41, rule_count: 2, _dump_id: 'ABS-CODE-QUALITY-009'});
CREATE (:Abstraction {summary: 'Retries use exponential backoff with jitter, not fixed intervals. Backoff base is at least 100ms; jitter is random within a window to avoid thundering herd; growth multiplier is 2-3x.', abstraction_id: 'ABS-CODE-QUALITY-014', project: 'writ', compression_ratio: 2.63, rule_count: 2, _dump_id: 'ABS-CODE-QUALITY-014'});
CREATE (:Abstraction {summary: 'Boolean comparisons to True/False literal are forbidden. Use the value directly: `if active:` not `if active == True:`. Negation: `if not active:` not `if active == False:`.', abstraction_id: 'ABS-CODE-QUALITY-016', project: 'writ', compression_ratio: 5.13, rule_count: 4, _dump_id: 'ABS-CODE-QUALITY-016'});
CREATE (:Abstraction {summary: 'Functions stay at or below 50 lines of logic (excluding declarations, comments, and blank lines). Longer functions are decomposed into named sub-functions that read as a top-down narrative.', abstraction_id: 'ABS-CODE-QUALITY-017', project: 'writ', compression_ratio: 5.54, rule_count: 4, _dump_id: 'ABS-CODE-QUALITY-017'});
CREATE (:Abstraction {summary: 'Magic literals are extracted to named constants with domain context. Numbers like 86400, 1000, 3, strings like \'admin\', \'success\' are replaced with named constants. Tax rates, fee thresholds, retry counts, status codes all carry names.', abstraction_id: 'ABS-CODE-QUALITY-018', project: 'writ', compression_ratio: 3.76, rule_count: 3, _dump_id: 'ABS-CODE-QUALITY-018'});
CREATE (:Abstraction {summary: 'Log values that originate from user input must be sanitized to prevent log injection or forging: strip or escape CR/LF, structure log entries as JSON or key-value pairs (one record per line) so injected newlines cannot fake additional log entries.', abstraction_id: 'ABS-CODE-QUALITY-032', project: 'writ', compression_ratio: 2.26, rule_count: 2, _dump_id: 'ABS-CODE-QUALITY-032'});
CREATE (:Abstraction {summary: 'Modules depend on abstractions (interfaces, protocols, base classes), not concrete implementations. Direct construction of concrete classes inside business logic is a violation; dependencies are injected.', abstraction_id: 'ABS-CODE-QUALITY-049', project: 'writ', compression_ratio: 6.01, rule_count: 4, _dump_id: 'ABS-CODE-QUALITY-049'});
CREATE (:Abstraction {summary: 'Every external call is wrapped in error handling with an explicit timeout. Bare network or file calls without try/except + timeout are violations. The handler logs, maps to a domain error, or retries deliberately.', abstraction_id: 'ABS-CODE-QUALITY-051', project: 'writ', compression_ratio: 5.44, rule_count: 4, _dump_id: 'ABS-CODE-QUALITY-051'});
CREATE (:Abstraction {summary: 'No empty catch blocks. Caught exceptions are either re-raised (preserving cause), logged with full context, or converted to a domain-specific error type. Swallowing exceptions silently is forbidden.', abstraction_id: 'ABS-CODE-QUALITY-055', project: 'writ', compression_ratio: 3.9, rule_count: 3, _dump_id: 'ABS-CODE-QUALITY-055'});
CREATE (:Abstraction {summary: 'Error responses must never expose internal paths, query text, schema details, library versions, stack traces, or env-var content to end users. Production handlers return a generic message with a correlation ID; the full detail goes to logs.', abstraction_id: 'ABS-CODE-QUALITY-061', project: 'writ', compression_ratio: 4.69, rule_count: 3, _dump_id: 'ABS-CODE-QUALITY-061'});
CREATE (:Abstraction {summary: 'Define SQL in a single heredoc or multi-line string. Split only when conditional WHERE clauses or dynamic JOINs require it.', abstraction_id: 'ABS-DATABASE-013', project: 'writ', compression_ratio: 4.04, rule_count: 2, _dump_id: 'ABS-DATABASE-013'});
CREATE (:Abstraction {summary: 'Advisory only. New-developer onboarding (local setup, test run, deploy to staging, common-task walkthroughs) is documented. Enforced at the repository-integrity-check level rather than per-file (the docs may live across multiple files).', abstraction_id: 'ABS-DOCUMENTATION-008', project: 'writ', compression_ratio: 2.52, rule_count: 2, _dump_id: 'ABS-DOCUMENTATION-008'});
CREATE (:Abstraction {summary: 'Return types are explicit. Implicit `Any`, `unknown`, `interface{}`, or unset return types are violations -- the contract is invisible to callers and the type checker.', abstraction_id: 'ABS-DOCUMENTATION-047', project: 'writ', compression_ratio: 4.9, rule_count: 3, _dump_id: 'ABS-DOCUMENTATION-047'});
CREATE (:Abstraction {summary: 'Queue-based features must declare complete infrastructure (primary queue, DLQ, retry policy, consumer config, monitoring) AND complete consumer behavior guarantees (idempotency, duplicate handling, retry failure escalation).', abstraction_id: 'ABS-ENFORCEMENT-019', project: 'writ', compression_ratio: 4.22, rule_count: 3, _dump_id: 'ABS-ENFORCEMENT-019'});
CREATE (:Abstraction {summary: 'Before writing validation logic, the AI must declare: what makes the entity legitimate at the domain level, whether legitimacy is structural (format) or persistence-based (exists in DB), and if persistence-based, which repository or service contract verifies existence.', abstraction_id: 'ABS-ENFORCEMENT-023', project: 'writ', compression_ratio: 3.68, rule_count: 3, _dump_id: 'ABS-ENFORCEMENT-023'});
CREATE (:Abstraction {summary: 'Do not optimize without measurement. Optimizations must cite the profiling evidence or performance requirement that justifies them. "For performance" is not a justification.', abstraction_id: 'ABS-ENFORCEMENT-025', project: 'writ', compression_ratio: 5.95, rule_count: 3, _dump_id: 'ABS-ENFORCEMENT-025'});
CREATE (:Abstraction {summary: 'Every state transition must declare a state machine (legal states and transitions), transition guards, an atomicity strategy, and contention handling. Bare read-then-write without a concurrency guard is always a violation.', abstraction_id: 'ABS-ENFORCEMENT-038', project: 'writ', compression_ratio: 7.41, rule_count: 4, _dump_id: 'ABS-ENFORCEMENT-038'});
CREATE (:Abstraction {summary: 'Before writing any plugin declaration, the AI must justify: why this specific class (not the interface, not a parent), why this hook type (before/around/after), what state is available at this execution point, and whether the logic depends on data only reliable after a specific side effect.', abstraction_id: 'ABS-ENFORCEMENT-045', project: 'writ', compression_ratio: 3.93, rule_count: 3, _dump_id: 'ABS-ENFORCEMENT-045'});
CREATE (:Abstraction {summary: 'Before injecting any dependency, verify it is safe in all execution contexts where the class will be invoked. MessageManager, session, or UI-dependent classes injected into service-layer classes are violations unless explicitly justified.', abstraction_id: 'ABS-ENFORCEMENT-050', project: 'writ', compression_ratio: 4.52, rule_count: 2, _dump_id: 'ABS-ENFORCEMENT-050'});
CREATE (:Abstraction {summary: '`CartTotalRepository::get()` only calls `$quote->collectTotals()` for virtual quotes. For non-virtual quotes, it reads previously-collected totals directly. Do not assume REST totals endpoints trigger fresh collection for all quote types.', abstraction_id: 'ABS-FRAMEWORKS-000', project: 'writ', compression_ratio: 4.46, rule_count: 3, _dump_id: 'ABS-FRAMEWORKS-000'});
CREATE (:Abstraction {summary: 'Request payloads must be validated against a typed schema (Pydantic, Marshmallow, Zod, Yup, JSON Schema, Joi, class-validator, Bean Validation) before business logic runs. Hand-rolled `if \'field\' in request.json` checks are insufficient.', abstraction_id: 'ABS-LANGUAGES-056', project: 'writ', compression_ratio: 2.52, rule_count: 2, _dump_id: 'ABS-LANGUAGES-056'});
CREATE (:Abstraction {summary: 'A node body must justify its token cost. The statement is the retrieval surface and carries the rule; the body stays lean. Per-node-type body budgets: Rule/AntiPattern <= 200 words, Technique/Skill <= 320, Playbook <= 600. Cut anything the agent already knows or that another node already says.', abstraction_id: 'ABS-META-AUTHORING-010', project: 'writ', compression_ratio: 3.09, rule_count: 2, _dump_id: 'ABS-META-AUTHORING-010'});
CREATE (:Abstraction {summary: 'The trigger field of a node must describe WHEN the node should activate, not WHAT the node does. Description-as-workflow-summary causes Claude to follow descriptions instead of reading skill bodies, fragmenting methodology retrieval at scale.', abstraction_id: 'ABS-META-AUTHORING-011', project: 'writ', compression_ratio: 3.22, rule_count: 2, _dump_id: 'ABS-META-AUTHORING-011'});
CREATE (:Abstraction {summary: 'Queries specify the columns needed, not `SELECT *`. Wide rows transferred over the network when the consumer needs three fields wastes bandwidth, memory, and ORM hydration time.', abstraction_id: 'ABS-PERFORMANCE-012', project: 'writ', compression_ratio: 3.12, rule_count: 2, _dump_id: 'ABS-PERFORMANCE-012'});
CREATE (:Abstraction {summary: 'Cache entries have an explicit TTL. Indefinite caching without an invalidation strategy is a violation. The TTL is short enough that stale data is bounded; the invalidation strategy is short enough that fresh data is bounded.', abstraction_id: 'ABS-PERFORMANCE-026', project: 'writ', compression_ratio: 4.72, rule_count: 4, _dump_id: 'ABS-PERFORMANCE-026'});
CREATE (:Abstraction {summary: 'Object references are released after use. Long-running processes do not retain unbounded structures (caches without eviction, growing dicts, accumulating lists). Memory-leak patterns are reviewed and bounded.', abstraction_id: 'ABS-PERFORMANCE-029', project: 'writ', compression_ratio: 7.54, rule_count: 5, _dump_id: 'ABS-PERFORMANCE-029'});
CREATE (:Abstraction {summary: 'I/O-bound operations use async / non-blocking calls, not synchronous blocking. The event loop is not stalled waiting for HTTP, DB, or file I/O.', abstraction_id: 'ABS-PERFORMANCE-039', project: 'writ', compression_ratio: 10.94, rule_count: 5, _dump_id: 'ABS-PERFORMANCE-039'});
CREATE (:Abstraction {summary: 'Code is reviewed by at least one other person or a reviewer agent before merge. Auto-merge on green CI is permitted only for trivial mechanical changes (dependency updates, formatter pushes) and is configured per-repo.', abstraction_id: 'ABS-PROCESS-004', project: 'writ', compression_ratio: 2.09, rule_count: 2, _dump_id: 'ABS-PROCESS-004'});
CREATE (:Abstraction {summary: 'Every bug fix is accompanied by a regression test that reproduces the bug. The test fails before the fix and passes after. The bug ticket / commit message references the test.', abstraction_id: 'ABS-PROCESS-015', project: 'writ', compression_ratio: 3.87, rule_count: 3, _dump_id: 'ABS-PROCESS-015'});
CREATE (:Abstraction {summary: 'Test skeletons are written and approved before the implementation. Tests carry the contract; the implementation conforms to them. ENF-PROC-TDD-001 mechanically enforces this in the Writ workflow.', abstraction_id: 'ABS-PROCESS-042', project: 'writ', compression_ratio: 3.23, rule_count: 2, _dump_id: 'ABS-PROCESS-042'});
CREATE (:Abstraction {summary: 'A claim rests on the most authoritative source reachable, not the first hit. Primary sources (the spec, the code, the dataset, the original announcement) outrank secondary descriptions, which outrank tertiary aggregations. If a primary source is one click away, the secondary one is a lead, not a citation.', abstraction_id: 'ABS-RESEARCH-001', project: 'writ', compression_ratio: 4.32, rule_count: 4, _dump_id: 'ABS-RESEARCH-001'});
CREATE (:Abstraction {summary: 'Readiness (`/ready`) and liveness (`/live`) probes are distinct. Ready = can serve traffic now (deps healthy, warmup done). Live = process is responsive but not necessarily ready. A liveness failure restarts the pod; a readiness failure removes it from rotation.', abstraction_id: 'ABS-SCALING-007', project: 'writ', compression_ratio: 3.45, rule_count: 3, _dump_id: 'ABS-SCALING-007'});
CREATE (:Abstraction {summary: 'Symmetric encryption must use AES-256-GCM, ChaCha20-Poly1305, or AES-256-SIV. ECB mode is forbidden. DES, 3DES, RC4, Blowfish are forbidden. Modes without authentication (CBC, CTR alone) require an explicit HMAC.', abstraction_id: 'ABS-SECURITY-003', project: 'writ', compression_ratio: 9.04, rule_count: 6, _dump_id: 'ABS-SECURITY-003'});
CREATE (:Abstraction {summary: 'Dependencies are pinned to an exact version or a narrow range (`~1.2.3`, `>=1.2,<1.3`), not open-ended (`*`, `^1.0.0` on critical libs, `latest`). Lockfiles capture exact resolution; manifests bound which resolutions are acceptable.', abstraction_id: 'ABS-SECURITY-005', project: 'writ', compression_ratio: 5.77, rule_count: 4, _dump_id: 'ABS-SECURITY-005'});
CREATE (:Abstraction {summary: 'Validation uses an allowlist (explicit set of permitted values) whenever the valid set is enumerable. Blocklists (reject these characters/values) are forbidden where allowlists are possible: blocklists are routinely incomplete and silently fail open on unanticipated inputs.', abstraction_id: 'ABS-SECURITY-024', project: 'writ', compression_ratio: 4.55, rule_count: 4, _dump_id: 'ABS-SECURITY-024'});
CREATE (:Abstraction {summary: 'Login and password-reset endpoints must return identical responses (same status, same body, same timing) for valid and invalid accounts. Discoverability of registered usernames or emails is a violation.', abstraction_id: 'ABS-SECURITY-027', project: 'writ', compression_ratio: 3.44, rule_count: 2, _dump_id: 'ABS-SECURITY-027'});
CREATE (:Abstraction {summary: 'Authentication endpoints carry their own rate limit, distinct from the general API limit. Login limits are per account AND per IP (per-account stops credential stuffing of a known user; per-IP stops bulk username enumeration).', abstraction_id: 'ABS-SECURITY-030', project: 'writ', compression_ratio: 4.33, rule_count: 3, _dump_id: 'ABS-SECURITY-030'});
CREATE (:Abstraction {summary: 'Data export endpoints must implement access controls (the same authz as the underlying records, plus an explicit \'can-export\' permission) and audit logging (who exported what, when). Per-request rate limits cap exfil volume.', abstraction_id: 'ABS-SECURITY-031', project: 'writ', compression_ratio: 2.79, rule_count: 2, _dump_id: 'ABS-SECURITY-031'});
CREATE (:Abstraction {summary: 'Content-Security-Policy header must be set on HTML responses. `unsafe-inline` and `unsafe-eval` are forbidden unless documented with the specific framework constraint that requires them. Default-src defaults to \'self\'.', abstraction_id: 'ABS-SECURITY-033', project: 'writ', compression_ratio: 8.49, rule_count: 6, _dump_id: 'ABS-SECURITY-033'});
CREATE (:Abstraction {summary: 'Session cookies must be set with Secure (HTTPS only), HttpOnly (no JS access), and SameSite=Lax or Strict. Authorization-header bearer tokens are transmitted only to HTTPS endpoints. Plain HTTP transmission of any session credential is forbidden.', abstraction_id: 'ABS-SECURITY-034', project: 'writ', compression_ratio: 2.57, rule_count: 2, _dump_id: 'ABS-SECURITY-034'});
CREATE (:Abstraction {summary: 'API responses explicitly select which fields to include via a response schema or serializer. Returning the full entity (`return user`, `return model.to_dict()`) leaks PII and internal state to clients; this is a violation. The serializer enforces the field allowlist; fields the requester is not authorized to see are excluded at the data layer, not redacted in middleware.', abstraction_id: 'ABS-SECURITY-057', project: 'writ', compression_ratio: 2.44, rule_count: 2, _dump_id: 'ABS-SECURITY-057'});
CREATE (:Abstraction {summary: 'Mock return values match the actual API/service response shape. A mock that returns `{\'ok\': True}` when the real service returns `{\'data\': {...}, \'status\': \'success\'}` produces tests that pass while real integration fails.', abstraction_id: 'ABS-TESTING-036', project: 'writ', compression_ratio: 3.86, rule_count: 3, _dump_id: 'ABS-TESTING-036'});
CREATE (:Abstraction {summary: 'Test fixtures or factories are used for object setup. Constructing the same domain object inline across many tests is a violation; factory functions (factory_boy, FactoryBot, pytest fixtures) own the construction logic.', abstraction_id: 'ABS-TESTING-037', project: 'writ', compression_ratio: 3.53, rule_count: 3, _dump_id: 'ABS-TESTING-037'});
CREATE (:Abstraction {summary: 'For any feature involving concurrent actors, state transitions, or DB constraints, declare which behaviors cannot be proven with mocks and which require integration tests against a real database. Claiming production-readiness for concurrent/async features with only mocked tests is a violation.', abstraction_id: 'ABS-TESTING-041', project: 'writ', compression_ratio: 3.56, rule_count: 3, _dump_id: 'ABS-TESTING-041'});
CREATE (:Abstraction {summary: 'Assertions are specific. `assertEqual(actual, 5)` beats `assertTrue(actual == 5)`; `assertGreater(x, y)` beats `assertTrue(x > y)`. Specific assertions produce specific failure messages.', abstraction_id: 'ABS-TESTING-044', project: 'writ', compression_ratio: 4.15, rule_count: 3, _dump_id: 'ABS-TESTING-044'});
CREATE (:Abstraction {summary: 'Every public function or method has at least one test. New public APIs are not committed without a test covering at least the happy path.', abstraction_id: 'ABS-TESTING-046', project: 'writ', compression_ratio: 4.72, rule_count: 3, _dump_id: 'ABS-TESTING-046'});
CREATE (:AntiPattern {severity: 'high', source_attribution: 'writ-native', evidence: 'peer-reviewed', confidence: 'peer-reviewed', staleness_window: 365, trigger_keywords: ['fourth fix', 'simultaneous changes', 'one change at a time'], project: 'writ', counter_nodes: ['PBK-PROC-DEBUG-001', 'ENF-PROC-DEBUG-001'], trigger: 'When the agent attempts multiple fixes simultaneously, or attempts a fourth fix after three have failed on the same bug.', antipattern_id: 'ANT-PROC-DEBUG-001', body: '# Anti-pattern: Multiple fixes / fourth-fix\n\n## Counter\n\nOne change at a time. Verify each. If three fixes failed: stop. Re-examine the architecture. The bug is bigger than a patch.', rationale: 'Parallel changes destroy the ability to attribute cause. Repeated fix attempts without new hypotheses indicate the bug model is wrong — the bug is architectural, not tactical.', tags: ['anti-pattern', 'debugging', 'multi-fix', 'process', 'three-fix-rule'], times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', named_in: 'writ-methodology:systematic-debugging', authority: 'human', domain: 'process', scope: 'task', statement: 'Multiple fixes at once or one-more-fix-attempt: attempting simultaneous changes makes it impossible to attribute cause; attempting a fourth fix after three failures means the architecture is wrong, not the patch.', last_validated: '2026-04-21', category: 'CAT-DISC-001', times_seen_positive: 0, _dump_id: 'ANT-PROC-DEBUG-001'});
CREATE (:AntiPattern {evidence: 'peer-reviewed', project: 'writ', body: '# Anti-pattern: Finish-time improvisation\n\nNon-retrievable companion to PBK-PROC-FINISH-001. Captures the finish-time mistakes the\nplaybook\'s fixed four-option flow and ordered cleanup exist to prevent.', times_seen_negative: 0, provenance: 'hand-authored', named_in: 'writ-methodology:finishing-a-development-branch', scope: 'task', statement: 'Finish-time improvisation is an anti-pattern. Present exactly the four fixed options (merge+cleanup, push+PR, keep, discard); never invent a fifth path. Order cleanup merge -> remove worktree -> delete branch (never delete a branch whose worktree still exists). Only remove worktrees this workflow created. Re-run tests on the merged result before declaring done.', last_validated: '2026-06-02', severity: 'medium', source_attribution: 'writ-native', confidence: 'peer-reviewed', staleness_window: 365, trigger_keywords: ['fixed four', 'fifth path', 'post-merge test'], counter_nodes: ['PBK-PROC-FINISH-001'], trigger: 'When wrapping up a completed branch: improvising a custom merge/cleanup flow, offering options beyond the fixed four, deleting a branch before removing its worktree, removing a worktree the workflow did not create, or skipping post-merge test re-verification.', antipattern_id: 'ANT-PROC-FINISH-001', rationale: 'A fixed option set and a fixed cleanup order eliminate novel-path improvisation when attention is lowest (work feels done). Wrong cleanup order orphans worktrees or loses commits; removing un-owned worktrees destroys others\' state; skipping post-merge verification ships an unverified merge.', tags: ['anti-pattern', 'branch', 'cleanup', 'finish', 'merge', 'process', 'worktree'], source_origin: 'ingest', authority: 'human', domain: 'process', action_triggers: ['finish'], category: 'CAT-DISC-001', times_seen_positive: 0, _dump_id: 'ANT-PROC-FINISH-001'});
CREATE (:AntiPattern {severity: 'medium', source_attribution: 'writ-native', evidence: 'peer-reviewed', confidence: 'peer-reviewed', staleness_window: 365, trigger_keywords: ['context bleed', 'broad scope', 'cross-domain'], project: 'writ', counter_nodes: ['SKL-PROC-PARALLEL-001'], trigger: 'When the agent proposes dispatching one subagent with a broad cross-domain scope (e.g., \'fix all the failing tests\') instead of one agent per independent problem domain.', antipattern_id: 'ANT-PROC-PARALLEL-001', body: '# Anti-pattern: Broad scope per parallel agent\n\n## The smell\n\n"One agent to fix all the failing tests." "One agent to investigate the entire slow-endpoint issue." Scope is cross-domain; agent has to thrash between contexts.\n\n## Counter\n\nDecompose first. One domain per agent. Then dispatch in parallel. See `SKL-PROC-PARALLEL-001` for the decision tree.', rationale: 'One-agent-to-rule-them-all defeats the parallelism: the agent sequentializes internally anyway, and its cross-domain context pollutes each subproblem\'s investigation. Independent failures in independent domains need independent agents.', tags: ['anti-pattern', 'broad-scope', 'parallel', 'process', 'subagents'], times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', named_in: 'writ-methodology:dispatching-parallel-agents', authority: 'human', domain: 'process', scope: 'task', statement: 'Broad scope per agent: one subagent handed multiple unrelated failures at once. Conflicts, context bleed, and partial results. The whole point of parallel dispatch is one agent per independent domain.', last_validated: '2026-04-21', category: 'CAT-DISC-001', times_seen_positive: 0, _dump_id: 'ANT-PROC-PARALLEL-001'});
CREATE (:AntiPattern {severity: 'high', source_attribution: 'writ-native', evidence: 'peer-reviewed', confidence: 'peer-reviewed', staleness_window: 365, trigger_keywords: ['placeholder content', 'deferred design decision', 'TBD'], project: 'writ', counter_nodes: ['SKL-PROC-PLAN-001', 'ENF-PROC-PLAN-001'], trigger: 'When a plan contains placeholder content (TBD, TODO, \'similar to task N\', \'implement appropriate error handling\', \'write tests for above\').', antipattern_id: 'ANT-PROC-PLAN-001', body: '# Anti-pattern: Placeholder content\n\n## Counter\n\nEvery step has: exact file path, complete code block, exact command. See `SKL-PROC-PLAN-001` and `TEC-PROC-SPEC-REVIEW-001` for the authoring + self-review discipline.', rationale: 'The plan is a contract between design and implementation. Placeholders break the contract — they force the implementer to guess. Guesses drift from user intent.', tags: ['anti-pattern', 'placeholder', 'planning', 'process', 'tbd'], times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', named_in: 'writ-methodology:writing-plans', authority: 'human', domain: 'process', scope: 'task', statement: 'Placeholder content in plans: each placeholder is a deferred design decision transferred to the implementer as interpretation. Non-reproducible plans.', last_validated: '2026-04-21', category: 'CAT-DISC-001', times_seen_positive: 0, _dump_id: 'ANT-PROC-PLAN-001'});
CREATE (:AntiPattern {severity: 'high', source_attribution: 'writ-native', evidence: 'peer-reviewed', confidence: 'peer-reviewed', staleness_window: 365, trigger_keywords: ['wrong review order', 'spec-compliance pass', 'code-quality pass'], project: 'writ', counter_nodes: ['PBK-PROC-SDD-001', 'ENF-PROC-SDD-001'], trigger: 'When the reviewer judges code-quality before confirming spec-compliance, or skips the spec-compliance pass entirely.', antipattern_id: 'ANT-PROC-SDD-001', body: '# Anti-pattern: Wrong review order in SDD\n\n## Counter\n\nSpec compliance first, always. If the spec pass fails: back to implementer. Only when the spec pass passes does the code-quality pass run. See `PBK-PROC-SDD-001`.', rationale: 'Spec-compliance is the coarser filter — it catches \'built the wrong thing.\' Code-quality is the finer filter — it polishes \'built the right thing.\' Inverting the order polishes wrongness.', tags: ['anti-pattern', 'process', 'review-order', 'sdd', 'spec-first'], times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', named_in: 'writ-methodology:subagent-driven-development', authority: 'human', domain: 'process', scope: 'task', statement: 'Wrong review order: running the code-quality pass before the spec-compliance pass wastes effort polishing code that implements the wrong spec.', last_validated: '2026-04-21', category: 'CAT-DISC-001', times_seen_positive: 0, _dump_id: 'ANT-PROC-SDD-001'});
CREATE (:AntiPattern {severity: 'high', source_attribution: 'writ-native', evidence: 'peer-reviewed', confidence: 'peer-reviewed', staleness_window: 365, trigger_keywords: ['passes immediately', 'watch it fail', 'vacuous condition'], project: 'writ', counter_nodes: ['PBK-PROC-TDD-001', 'ENF-PROC-TDD-001'], trigger: 'When a test \'passes\' on first run after being written, or when the agent cannot explain why the test would have failed before implementation existed.', antipattern_id: 'ANT-PROC-TDD-001', body: '# Anti-pattern: Test passes on first run\n\n## Why this is broken\n\nThe RED phase of TDD is not a formality. A test that passes immediately could be:\n\n- Testing a different behavior than you intended (false positive).\n- Testing a vacuous condition (`assert True`).\n- Testing behavior that already happened to exist (no new assertion made).\n- Silently skipping via a framework feature (`@pytest.mark.skip`, wrong decorator).\n\nIf you cannot state, in one sentence, what the test output was when it failed and why that failure was the correct failure, the test is not trustworthy.\n\n## Counter\n\nDelete the test file. Start over. Write the test first, run it against the missing implementation, read the failure output, confirm the failure is the expected "function undefined" or "assertion X != Y" failure, and only then write the minimal implementation to make it pass.\n\n## Example\n\n- **Bad:** Wrote `test_add_two_numbers()`, ran, passed first try. Cannot explain why.\n- **Good:** Wrote `test_add_two_numbers()`, ran, got `NameError: name \'add\' is not defined`. Wrote `def add(a, b): return a + b`. Re-ran, passed. Now the test is trusted.\n\n## Related anti-patterns\n\n- `ANT-PROC-TDD-002` — testing the mock instead of the behavior\n- `ANT-PROC-TDD-005` — "I\'ll write the test after the code" (test-after)', rationale: 'Watching the test fail for the right reason is the only evidence that the test exercises the intended behavior. Without the red phase, false-positive tests accumulate silently and destroy test-suite trust.', tags: ['anti-pattern', 'process', 'red-phase', 'tdd', 'test-watches-nothing'], times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', named_in: 'writ-methodology:testing-anti-patterns', authority: 'human', domain: 'process', scope: 'task', statement: 'Test that passes immediately after being written is an anti-pattern: you did not watch it fail, so you do not know whether it tests the intended behavior or some coincidental truth. Delete the test, start over, write it first, watch it fail for the right reason, then implement.', last_validated: '2026-04-21', category: 'CAT-DISC-001', times_seen_positive: 0, _dump_id: 'ANT-PROC-TDD-001'});
CREATE (:AntiPattern {severity: 'high', source_attribution: 'writ-native', evidence: 'peer-reviewed', confidence: 'peer-reviewed', staleness_window: 365, trigger_keywords: ['testing the mock', 'mock the collaborators', 'real output values'], project: 'writ', counter_nodes: ['PBK-PROC-TDD-001'], trigger: 'When a test uses a mock for the very function or class it claims to verify.', antipattern_id: 'ANT-PROC-TDD-002', body: '# Anti-pattern: Testing the mock\n\n## The smell\n\n`mock.assert_called_with(expected_args)` as the primary assertion. No assertion against real output. Real code could be returning wrong values; test still passes.\n\n## Counter\n\nMock the collaborators, not the subject. Assert on real output values. If you can\'t avoid mocking the subject, the test design is wrong — consider integration-level test instead.', rationale: 'Mocks exist to isolate collaborators, not the subject under test. Mocking the subject replaces behavior verification with call-pattern verification, which is vacuous.', tags: ['anti-pattern', 'mock', 'process', 'tdd', 'testing-the-mock'], times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', named_in: 'writ-methodology:testing-anti-patterns', authority: 'human', domain: 'process', scope: 'task', statement: 'Testing the mock instead of the behavior: the test asserts that the mock was called with certain arguments instead of that the real code produces correct output. Passes when the real code is broken.', last_validated: '2026-04-21', category: 'CAT-DISC-001', times_seen_positive: 0, _dump_id: 'ANT-PROC-TDD-002'});
CREATE (:AntiPattern {severity: 'high', source_attribution: 'writ-native', evidence: 'peer-reviewed', confidence: 'peer-reviewed', staleness_window: 365, trigger_keywords: ['test-only methods', 'public surface', 'coupled to implementation'], project: 'writ', counter_nodes: ['PBK-PROC-TDD-001'], trigger: 'When a test calls private/internal methods (e.g., Python `_name` prefix, or class-private fields exposed only for test access).', antipattern_id: 'ANT-PROC-TDD-003', body: '# Anti-pattern: Test-only methods\n\n## The smell\n\nPublic method, field, or getter added "just so tests can verify X." Removed in refactor → tests break, production unaffected.\n\n## Counter\n\nTest through the public interface. If behavior is hard to reach through public methods, the public interface is missing something the user of the class also needs — not just the test.', rationale: 'Tests that reach internals break on refactor even when behavior is unchanged. A test that tests behavior should not care how the behavior is produced internally.', tags: ['anti-pattern', 'encapsulation', 'process', 'tdd', 'test-only-method'], times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', named_in: 'writ-methodology:testing-anti-patterns', authority: 'human', domain: 'process', scope: 'task', statement: 'Test-only methods: production code gains a public surface that exists only so tests can reach internal state. The test is then coupled to implementation, not behavior.', last_validated: '2026-04-21', category: 'CAT-DISC-001', times_seen_positive: 0, _dump_id: 'ANT-PROC-TDD-003'});
CREATE (:AntiPattern {severity: 'medium', source_attribution: 'writ-native', evidence: 'peer-reviewed', confidence: 'peer-reviewed', staleness_window: 365, trigger_keywords: ['incomplete mocks', 'real collaborator', 'same seam'], project: 'writ', counter_nodes: ['PBK-PROC-TDD-001'], trigger: 'When a mock is configured with partial behavior that differs from the real collaborator\'s contract (e.g., mocks return None where real code would raise).', antipattern_id: 'ANT-PROC-TDD-004', body: '# Anti-pattern: Incomplete mocks\n\n## The smell\n\nMock returns a default value when the real collaborator would raise. Mock returns success when the real collaborator would time out. Test passes; integration fails in the same direction the mock diverged.\n\n## Counter\n\nMock behavior must match the real collaborator\'s contract at least on the paths the test exercises. Prefer integration tests or fakes for collaborators with complex failure modes.', rationale: 'A mock is a hypothesis about the collaborator. An incomplete hypothesis produces a test that verifies the wrong thing. The bug migrates from code to test configuration.', tags: ['anti-pattern', 'incomplete-mock', 'mock', 'process', 'tdd'], times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', named_in: 'writ-methodology:testing-anti-patterns', authority: 'human', domain: 'process', scope: 'task', statement: 'Incomplete mocks: the mock\'s behavior diverges from the real collaborator in ways that mask bugs. Tests pass; production fails at the same seam the mock covered.', last_validated: '2026-04-21', category: 'CAT-DISC-001', times_seen_positive: 0, _dump_id: 'ANT-PROC-TDD-004'});
CREATE (:AntiPattern {severity: 'high', source_attribution: 'writ-native', evidence: 'peer-reviewed', confidence: 'battle-tested', staleness_window: 365, trigger_keywords: ['test-after', 'pass trivially', 'sunk cost'], project: 'writ', counter_nodes: ['PBK-PROC-TDD-001', 'ENF-PROC-TDD-001'], trigger: 'When the agent writes production code first and adds tests afterward (test-after), or rationalizes that \'tests after achieve the same purpose.\'', antipattern_id: 'ANT-PROC-TDD-005', body: '# Anti-pattern: Test after implementation\n\n## The rationalizations\n\n- "I already manually tested it."\n- "Tests after achieve the same purpose."\n- "Deleting X hours of work to restart is wasteful."\n- "The code works, the tests will just confirm."\n\n## The counter\n\nDelete the code. Write the test first. Watch it fail. Then write the code. No exceptions for sunk cost.', rationale: 'Test-first forces clear interface design before implementation. Test-after forces tests to accommodate whatever got implemented. The former catches design errors; the latter ratifies them.', tags: ['anti-pattern', 'process', 'tdd', 'test-after', 'test-first-discipline'], times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', named_in: 'writ-methodology:test-driven-development', authority: 'human', domain: 'process', scope: 'task', statement: 'Test-after: tests written after code become confirmations of what was built, not specifications of what should be built. They pass trivially and miss design-level errors.', last_validated: '2026-04-21', category: 'CAT-DISC-001', times_seen_positive: 0, _dump_id: 'ANT-PROC-TDD-005'});
CREATE (:AntiPattern {severity: 'medium', source_attribution: 'writ-native', evidence: 'peer-reviewed', confidence: 'peer-reviewed', staleness_window: 365, trigger_keywords: ['over-engineering', 'premature abstraction', 'while I\'m here'], project: 'writ', counter_nodes: ['PBK-PROC-TDD-001'], trigger: 'In the GREEN phase of TDD: when adding configuration options, parameters, abstractions, or refactors that the current failing test does not require, or rationalizing \'might as well add it while I\'m here.\'', antipattern_id: 'ANT-PROC-TDD-006', body: '# Anti-pattern: Over-engineering in GREEN\n\n## The smell\n\nThe failing test needs a three-line function; the commit adds an options object, a strategy\nhook, and a "while I\'m here" refactor of the neighboring module. None of it is demanded by a\nfailing test.\n\n## The rationalizations\n\n- "Might as well add the options now, I\'ll need them later."\n- "It\'s cleaner to abstract this up front."\n- "I\'m already in this file, I\'ll tidy it too."\n\n## The counter\n\nIn GREEN, write the minimal code that makes the current test pass -- no more, no less. Defer\nevery extra capability to its own RED: if you want the option, write the failing test for it\nfirst. Refactor only after green, and only with the tests still passing.', rationale: 'GREEN\'s job is exactly enough code to turn the test green; every line beyond that is untested, unrequested, and harder to change later. Speculative generality (the options-bag, the extra hook) is the YAGNI failure the cycle exists to prevent. New behavior earns its own RED first.', tags: ['anti-pattern', 'tdd', 'green', 'over-engineering', 'yagni', 'minimal', 'process'], times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', named_in: 'writ-methodology:test-driven-development', authority: 'human', domain: 'process', scope: 'task', statement: 'GREEN over-engineering: writing more than the minimal code that makes the test pass -- speculative options, premature abstraction, or refactoring unrelated code during GREEN. The extra code has no failing test, so it is unverified behavior smuggled in under a passing one.', last_validated: '2026-06-03', category: 'CAT-DISC-001', times_seen_positive: 0, _dump_id: 'ANT-PROC-TDD-006'});
CREATE (:AntiPattern {severity: 'high', source_attribution: 'writ-native', evidence: 'peer-reviewed', confidence: 'peer-reviewed', staleness_window: 365, trigger_keywords: ['absence claim', 'search roots', 'green scan'], project: 'writ', counter_nodes: ['PBK-PROC-TDD-001'], trigger: 'When a test asserts that something exists NOWHERE -- no caller does X, zero occurrences of Y remain -- and selects the files it searches itself (a glob, a directory list, a line-by-line match).', antipattern_id: 'ANT-PROC-TDD-007', body: '# Anti-pattern: The scan that cannot observe what it claims to prove\n\n## The smell\n\nA test named "nothing does X any more" that searches a directory list, a glob, or one line at\na time. Nobody ever asked where a file of that kind can legitimately live, so the roots are\nwhichever ones the author happened to have open.\n\n## What it looked like\n\nThree shipped in this repo on one day, 2026-08-08:\n\n- A scan globbed `hooks/scripts/*.sh` and read clean while the session-id fallback sat in\n  `bin/lib/common.sh` -- the one file 21 hooks source. It read 37 copies of the fix and never\n  opened the original.\n- A scan required `python3 -c` and `json` on the same line, so multi-line embedded blocks\n  were invisible: zero reported, five live.\n- A third asserted the fallback MUST be produced, encoding the defect as the requirement.\n\nThe first two shipped with anti-vacuity tests that planted a matching string. Both proved the\nregex had teeth. Neither proved the search reached the code.\n\n## The counter\n\nDeclare two things and check both before searching: the universe (every directory a file of\nthat kind may live in) and the roots this scan opens. Fail when the roots do not cover the\nuniverse, and fail when a file of that kind turns up outside the universe. Read whole files,\nnever lines. Then prove the guard rejects the original narrow scope, not just that the\npattern matches a plant.', rationale: 'An absence claim passes by finding nothing, so a search that cannot reach the code is indistinguishable from a codebase that does not contain it. Every other assertion fails when it is pointed at the wrong thing; this one goes green. Proving the pattern has teeth against a planted string proves nothing about the roots.', tags: ['anti-pattern', 'absence-claim', 'coverage', 'process', 'scope', 'tdd'], times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', named_in: 'writ-methodology:testing-anti-patterns', authority: 'human', domain: 'process', scope: 'task', statement: 'Absence claim narrower than its universe: the search covers less ground than the claim, so the test reports zero because it never opened the file the offender lives in. The tell is a green scan reporting zero while the defect is live. Declare the universe the claim covers, and fail the test when the declared search roots do not cover it.', last_validated: '2026-08-08', category: 'CAT-DISC-001', times_seen_positive: 0, _dump_id: 'ANT-PROC-TDD-007'});
CREATE (:AntiPattern {evidence: 'peer-reviewed', project: 'writ', body: '# Anti-pattern: Trust subagent success reports\n\n## Counter\n\nRun the verification command yourself, in this message. Subagent reports are hypotheses, not evidence. Fresh run is evidence.', times_seen_negative: 0, provenance: 'hand-authored', named_in: 'writ-methodology:verification-before-completion', scope: 'session', statement: 'Trusting subagent success reports: the implementer subagent says \'done\'; the agent marks task complete without fresh verification. Subagent was wrong; bug ships.', last_validated: '2026-04-21', severity: 'critical', source_attribution: 'writ-native', confidence: 'battle-tested', staleness_window: 365, trigger_keywords: ['fresh verification', 'reported success', 'run the verification'], counter_nodes: ['SKL-PROC-VERIFY-001', 'ENF-PROC-VERIFY-001'], trigger: 'When the agent claims success based on a subagent\'s reported success, without running the verification command itself.', antipattern_id: 'ANT-PROC-VERIFY-001', rationale: 'Subagents can be wrong. Their confidence is not evidence. The verification discipline exists precisely because confidence-as-evidence is the canonical agentic-coding failure mode.', tags: ['anti-pattern', 'process', 'subagent-trust', 'verification'], source_origin: 'ingest', authority: 'human', domain: 'process', category: 'CAT-DISC-001', floor_modes: ['conversation', 'debug', 'review', 'work', 'investigate'], times_seen_positive: 0, _dump_id: 'ANT-PROC-VERIFY-001'});
CREATE (:AntiPattern {evidence: 'peer-reviewed', project: 'writ', body: '# Anti-pattern: Fighting the harness on worktrees\n\n## The smell\n\n- `git worktree add ...` typed directly while `EnterWorktree` (or an equivalent native tool) is\n  right there.\n- A new worktree created without running Step 0 -- so it lands nested inside the worktree you\n  were already in.\n\n## The counter\n\nDetect existing isolation first (`TEC-PROC-WORKTREE-001` Step 0): if already in a linked\nworktree, do not create another. Then prefer the native worktree tool; fall back to\n`git worktree add` only when none exists. Native tools keep placement, branch, and cleanup in\nsync with the harness; raw git does not.', times_seen_negative: 0, provenance: 'hand-authored', named_in: 'writ-methodology:using-git-worktrees', scope: 'task', statement: 'Fighting the harness: running raw `git worktree add` when a native worktree tool exists, or creating a nested worktree because you skipped the detect-existing-isolation check. Native tools own placement, branch creation, and cleanup; raw git behind their back leaves phantom state the harness cannot see, and a nested worktree compounds it.', last_validated: '2026-06-03', severity: 'medium', source_attribution: 'writ-native', confidence: 'peer-reviewed', staleness_window: 365, trigger_keywords: ['git worktree add', 'fighting the harness', 'nested worktree'], counter_nodes: ['SKL-PROC-WORKTREE-001'], trigger: 'When setting up isolated feature work: reaching for `git worktree add` while a native worktree tool (EnterWorktree, a /worktree command, a --worktree flag) is available, or creating a worktree without first checking whether the current checkout is already a linked worktree.', antipattern_id: 'ANT-PROC-WORKTREE-001', rationale: 'The native tool and the harness share state that `git worktree add` does not update, so manual worktrees become orphans the harness cannot clean up. Skipping Step 0 creates a worktree inside a worktree, doubling the confusion. Both are avoided by detecting isolation first and preferring native tools.', tags: ['anti-pattern', 'worktree', 'isolation', 'native-tools', 'harness', 'process'], source_origin: 'ingest', authority: 'human', domain: 'process', action_triggers: ['worktree'], category: 'CAT-DISC-001', times_seen_positive: 0, _dump_id: 'ANT-PROC-WORKTREE-001'});
CREATE (:Rule {severity: 'high', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review. API diff tools (openapi-diff) detect breaking changes in CI.', project: 'writ', trigger: 'When modifying an existing API endpoint or schema.', pass_example: '```\n# /v1/users still returns {\'name\'} (computed from first/last);\n# /v2/users returns {\'first_name\', \'last_name\'}.\n# v1 deprecated; sunset date communicated.\n```', rationale: 'Silent breakage is invisible to the team that ships and disastrous to the team that consumes. Versioning makes the contract visible.\n\nRelated rules: API-CONTRACT-001, API-VERSION-001.', mandatory: false, rule_id: 'API-BREAKING-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', violation: '```\n# /v1/users used to return {\'name\': \'...\'}; today returns {\'first_name\', \'last_name\'}; clients break silently.\n```', domain: 'api-design', scope: 'component', statement: 'Breaking changes (removed field, renamed field, changed type, removed endpoint, narrowed accepted input) are versioned. Silent contract changes are violations: the old version stays usable until clients migrate.', last_validated: '2026-08-13', category: 'CAT-CODE-API-001', times_seen_positive: 0, _dump_id: 'API-BREAKING-001'});
CREATE (:Rule {severity: 'high', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'CI gate: generated spec is committed; CI verifies it matches code.', project: 'writ', trigger: 'When designing or modifying an API endpoint.', pass_example: '```\n# FastAPI generates /docs from Pydantic models. Spec is always in sync.\n```', rationale: 'Hand-written docs drift. Generated docs stay in sync because they are the code.\n\nRelated rules: API-BREAKING-001, DOC-API-001.', mandatory: false, rule_id: 'API-CONTRACT-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', violation: '```\n# API doc is a wiki page maintained separately from code; drifts immediately.\n```', domain: 'api-design', scope: 'component', statement: 'API request/response schemas are documented via OpenAPI, JSON Schema, GraphQL SDL, or framework-native equivalent. The documentation is generated from the source of truth (Pydantic models, TypeScript types, etc.), not hand-written.', last_validated: '2026-08-13', category: 'CAT-CODE-API-001', times_seen_positive: 0, _dump_id: 'API-CONTRACT-001'});
CREATE (:Rule {severity: 'high', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review. Pydantic-based response models enforce the shape.', project: 'writ', trigger: 'When returning error responses from API endpoints.', pass_example: '```python\nclass ErrorResponse(BaseModel):\n    error: str            # machine-readable code\n    message: str          # human-readable description\n    details: list[FieldError] | None = None\n# All handlers return ErrorResponse on failure.\n```', rationale: 'Consistent error schemas let one client error-handler work everywhere. Inconsistent schemas force per-endpoint parsing.\n\nRelated rules: API-ERROR-002, API-STATUS-001.', mandatory: false, rule_id: 'API-ERROR-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', violation: '```python\n# Some endpoints return \'error\': \'msg\'; others return \'message\': \'msg\'; others return a string body.\n```', domain: 'api-design', scope: 'component', statement: 'Error responses follow a consistent schema: error code (machine-readable), message (human-readable), and field-level details where applicable. The schema is documented and applied across every endpoint.', last_validated: '2026-08-13', category: 'CAT-CODE-API-001', times_seen_positive: 0, _dump_id: 'API-ERROR-001'});
CREATE (:Rule {severity: 'medium', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review.', project: 'writ', trigger: 'When writing error messages returned to API consumers.', pass_example: '```python\nreturn {\'error\': \'INVALID_FIELD\', \'message\': \'Field `quantity` must be a positive integer; received -5\'}, 400\n```', rationale: 'Actionable errors halve the time-to-fix for integration partners. Bare messages force them to grep the source.\n\nRelated rules: API-ERROR-001, CLEAN-ERR-003.', mandatory: false, rule_id: 'API-ERROR-002', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', violation: '```python\nreturn {\'error\': \'Bad request\'}, 400\n```', domain: 'api-design', statement: 'Error messages are actionable: they tell the caller what to fix, not just what failed. \'Invalid input\' is a violation; \'Field `email` must be a valid email address\' is the structure.', last_validated: '2026-08-13', category: 'CAT-CODE-API-001', times_seen_positive: 0, _dump_id: 'API-ERROR-002'});
CREATE (:Rule {severity: 'medium', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review.', project: 'writ', trigger: 'When implementing PUT and DELETE endpoints.', pass_example: '```python\n@app.delete(\'/users/<id>\')\ndef delete_user(id):\n    user = User.query.get(id)\n    if user:\n        user.delete()\n    return \'\', 204  # 204 whether or not the user existed\n```', rationale: 'Network retries are universal. Idempotent PUT/DELETE makes retries safe; non-idempotent versions risk duplicate-state bugs.\n\nRelated rules: API-REST-001, ARCH-IDEMPOTENT-001.', mandatory: false, rule_id: 'API-IDEMPOTENT-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', violation: '```python\n@app.delete(\'/users/<id>\')\ndef delete_user(id):\n    user = User.query.get_or_404(id)  # 404 on second call -> not idempotent\n    user.delete()\n    return \'\', 204\n```', domain: 'api-design', statement: 'PUT and DELETE are idempotent: calling the same endpoint twice produces the same final state. PUT replaces; DELETE removes (deleting an already-deleted resource is not an error). Repeated calls do not produce duplicate side effects.', last_validated: '2026-08-13', category: 'CAT-CODE-API-001', times_seen_positive: 0, _dump_id: 'API-IDEMPOTENT-001'});
CREATE (:Rule {severity: 'high', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review.', project: 'writ', trigger: 'When implementing list endpoints.', pass_example: '```python\n@app.get(\'/orders\')\ndef list_orders(cursor: str | None = None, limit: int = 25):\n    items, next_cursor = paginate(Order.query, cursor, limit)\n    return {\'items\': items, \'next_cursor\': next_cursor}\n```', rationale: 'Pagination contains the API\'s worst-case response size. Consistent schemes let one client library work across every endpoint.\n\nRelated rules: API-PAGINATION-002, PERF-QUERY-004, SEC-RATE-QUERY-001.', mandatory: false, rule_id: 'API-PAGINATION-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', violation: '```python\n@app.get(\'/orders\')\ndef list_orders():\n    return Order.query.all()  # unbounded\n```', domain: 'api-design', scope: 'component', statement: 'List endpoints are paginated with a consistent scheme across the API: cursor-based (preferred for large/changing sets) or offset-based with total count. The pagination metadata (next, prev, total) is included in the response envelope.', last_validated: '2026-08-13', category: 'CAT-CODE-API-001', times_seen_positive: 0, _dump_id: 'API-PAGINATION-001'});
CREATE (:Rule {severity: 'medium', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review.', project: 'writ', trigger: 'When parameterizing page-size on list endpoints.', pass_example: '```python\nper_page = min(int(request.args.get(\'per_page\', 25)), 200)\n```', rationale: 'Server-side caps prevent a single request from exhausting capacity. The default keeps responses fast for the common case.\n\nRelated rules: API-PAGINATION-001.', mandatory: false, rule_id: 'API-PAGINATION-002', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', violation: '```python\nper_page = int(request.args.get(\'per_page\', 100))  # client can pass 1000000\n```', domain: 'api-design', statement: 'Default page size is small (10-25). Maximum page size is enforced server-side. Clients cannot bypass the limit by passing a larger `per_page`.', last_validated: '2026-08-13', category: 'CAT-CODE-API-001', times_seen_positive: 0, _dump_id: 'API-PAGINATION-002'});
CREATE (:Rule {severity: 'medium', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review.', project: 'writ', trigger: 'When defining HTTP endpoints in a REST-style API.', pass_example: '```python\n@app.delete(\'/users/<id>\')\ndef delete_user(id): User.query.get(id).delete()\n```', mandatory: false, rationale: 'Method semantics drive correctness for caches, retries, and CSRF protections. A GET that deletes can be triggered by a link preview.\n\nRelated rules: API-IDEMPOTENT-001, API-REST-002.', rule_id: 'API-REST-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', domain: 'api-design', violation: '```python\n@app.get(\'/users/<id>/delete\')\ndef delete_user(id): User.query.get(id).delete()\n```', statement: 'HTTP methods match semantics: GET for reads (idempotent, no side effects), POST for creates, PUT/PATCH for updates, DELETE for deletes. A GET that mutates state is a violation.', last_validated: '2026-08-13', category: 'CAT-CODE-API-001', times_seen_positive: 0, _dump_id: 'API-REST-001'});
CREATE (:Rule {severity: 'medium', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review.', project: 'writ', trigger: 'When defining URL paths for REST endpoints.', pass_example: '```\nGET /api/users\nDELETE /api/orders/123\n```', mandatory: false, rationale: 'Noun-based URLs let the method carry the verb. The URL identifies the resource; the method says what to do with it.\n\nRelated rules: API-REST-001.', rule_id: 'API-REST-002', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', domain: 'api-design', violation: '```\nGET /api/getUsers\nPOST /api/deleteOrder?id=123\n```', statement: 'Resource URLs are nouns. `/users`, `/orders/123`, `/orders/123/cancel`. Verb-style URLs (`/getUsers`, `/deleteOrder`) are violations except for explicit action endpoints (`/orders/123/cancel` is acceptable because it\'s an action on a noun).', last_validated: '2026-08-13', category: 'CAT-CODE-API-001', times_seen_positive: 0, _dump_id: 'API-REST-002'});
CREATE (:Rule {severity: 'high', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review.', project: 'writ', trigger: 'When returning responses from API endpoints.', pass_example: '```python\nreturn {\'error\': \'not found\'}, 404\n```', mandatory: false, rationale: 'Status codes are the integration contract for clients, monitors, and load balancers. Mismatched codes break retries, alerts, and circuit breakers.\n\nRelated rules: API-ERROR-001, API-STATUS-002.', rule_id: 'API-STATUS-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', domain: 'api-design', violation: '```python\nreturn {\'error\': \'not found\'}, 200\n```', statement: 'Response status codes match the outcome: 201 for created, 204 for no-content, 400 for client error, 401 unauth, 403 forbidden, 404 not found, 409 conflict, 422 validation, 5xx for server errors. Returning 200 for failures or 500 for validation is a violation.', last_validated: '2026-08-13', category: 'CAT-CODE-API-001', times_seen_positive: 0, _dump_id: 'API-STATUS-001'});
CREATE (:Rule {severity: 'medium', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review. Monitoring should track 5xx separately from 4xx.', project: 'writ', trigger: 'When deciding the status code for a handled error.', pass_example: '```python\nif not is_valid(payload):\n    return error(\'invalid\'), 422\n```', mandatory: false, rationale: '5xx tagging triggers paging and dashboard alerts. Misclassifying 4xx as 5xx floods the incident channel with non-incidents.\n\nRelated rules: API-STATUS-001.', rule_id: 'API-STATUS-002', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', domain: 'api-design', violation: '```python\nif not is_valid(payload):\n    return error(\'invalid\'), 500  # 4xx-class problem, but tagged as server error\n```', statement: '5xx codes are never caused by invalid user input. Bad input produces 4xx (typically 400 or 422). 5xx is reserved for server-side faults the user could not have caused (DB down, dependency failure, unhandled exception).', last_validated: '2026-08-13', category: 'CAT-CODE-API-001', times_seen_positive: 0, _dump_id: 'API-STATUS-002'});
CREATE (:Rule {severity: 'medium', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review.', project: 'writ', trigger: 'When designing an API that may change over time.', pass_example: '```python\n# /api/v1/users frozen; /api/v2/users for new shape.\n```', rationale: 'Versioning lets the API evolve without breaking existing clients. Unversioned APIs make every change a coordinated client upgrade.\n\nRelated rules: API-BREAKING-001, API-CONTRACT-001.', mandatory: false, rule_id: 'API-VERSION-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', violation: '```python\n# /api/users returns one shape today, another after a refactor; no version mechanism.\n```', domain: 'api-design', statement: 'API versioning strategy is defined and enforced: URL path (`/v1/`, `/v2/`), header (`Accept: application/vnd.api.v2+json`), or query param. Mixing strategies or omitting versioning is a violation; a documented choice is consistently applied.', last_validated: '2026-08-13', category: 'CAT-CODE-API-001', times_seen_positive: 0, _dump_id: 'API-VERSION-001'});
CREATE (:Rule {severity: 'high', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Linter rule (eslint @typescript-eslint/no-floating-promises, ruff RUF006 / asyncio).', project: 'writ', trigger: 'When calling an async function (Python `async def`, Node `async`/`Promise`, Rust `async fn`).', pass_example: '```javascript\nawait sendEmail(user.email);\n// Or, when truly fire-and-forget:\nsendEmail(user.email).catch(err => logger.error(\'email failed\', err));\n// Or, register with a task supervisor:\ntaskSupervisor.spawn(() => sendEmail(user.email));\n```', rationale: 'Floating async work loses errors and timing. The await (or supervised spawn) is the structural defense.\n\nRelated rules: ARCH-ASYNC-002, PERF-BATCH-001.', mandatory: false, rule_id: 'ARCH-ASYNC-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', violation: '```javascript\nasync function sendEmail(to) { ... }\n// Caller:\nsendEmail(user.email);  // unhandled Promise; failures invisible\n```', domain: 'architecture', scope: 'component', statement: 'Async function results are awaited at all call sites. Fire-and-forget invocations (unawaited Promises, dropped coroutines, ignored futures) are forbidden unless explicitly justified and tracked (background task registry).', last_validated: '2026-08-13', category: 'CAT-CODE-ARCH-001', times_seen_positive: 0, _dump_id: 'ARCH-ASYNC-001'});
CREATE (:Rule {severity: 'medium', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Linter rule (asyncio-blocker-style check). Code review.', project: 'writ', trigger: 'When writing code that runs inside an async event loop (Python asyncio, Node, Tokio).', pass_example: '```python\nasync def process(item):\n    response = await httpx.AsyncClient().get(item.url)\n    await asyncio.sleep(1)\n# CPU-bound: await loop.run_in_executor(None, cpu_heavy, item)\n```', mandatory: false, rationale: 'A single blocking call inside the event loop stalls every concurrent task. Async I/O preserves the concurrency model.\n\nRelated rules: ARCH-ASYNC-001, PERF-ASYNC-001, PY-ASYNC-001.', rule_id: 'ARCH-ASYNC-002', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', domain: 'architecture', violation: '```python\nasync def process(item):\n    response = requests.get(item.url)  # sync HTTP in async fn -- blocks loop\n    time.sleep(1)                       # blocks loop\n```', statement: 'Blocking calls inside the event loop are forbidden: no synchronous I/O, no `time.sleep` (use `asyncio.sleep`), no CPU-bound loops in the main coroutine. CPU-bound work runs in an executor; blocking I/O runs in a thread pool.', last_validated: '2026-08-13', category: 'CAT-CODE-ARCH-001', times_seen_positive: 0, _dump_id: 'ARCH-ASYNC-002'});
CREATE (:Rule {severity: 'high', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review.', project: 'writ', trigger: 'When integrating with external services (HTTP APIs, third-party SDKs, message queues, cloud services).', pass_example: '```python\nclass PaymentGateway:\n    def charge(self, customer, amount): ...\nclass OrderService:\n    def charge(self, order):\n        return self.payments.charge(order.customer, order.amount)\n```', mandatory: false, rationale: 'Raw external calls in business code couple every caller to the vendor\'s API shape, error model, and retry semantics. Adapter classes isolate that surface.\n\nRelated rules: ERR-CIRCUIT-001, ERR-TIMEOUT-001, SOLID-DIP-001.', rule_id: 'ARCH-BOUNDARY-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', domain: 'architecture', violation: '```python\nclass OrderService:\n    def charge(self, order):\n        resp = requests.post(\'https://api.stripe.com/v1/charges\', ...)  # raw\n```', statement: 'External service calls are wrapped in an adapter/client class. Business logic invokes the adapter, never the raw HTTP/SDK call. The adapter centralizes retries, timeouts, error mapping, and observability.', last_validated: '2026-08-13', category: 'CAT-CODE-ARCH-001', times_seen_positive: 0, _dump_id: 'ARCH-BOUNDARY-001'});
CREATE (:Rule {severity: 'medium', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review. Import linting can restrict imports of specific libraries to specific modules.', project: 'writ', trigger: 'When using a third-party library across multiple modules.', pass_example: '```python\n# infra/http.py imports requests/httpx; everyone else imports infra.http.\n```', mandatory: false, rationale: 'Concentrated library use trades a one-line import for the ability to migrate the library later. Scattered imports trade short-term convenience for long-term lock-in.\n\nRelated rules: ARCH-BOUNDARY-001, SOLID-DIP-001.', rule_id: 'ARCH-BOUNDARY-002', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', domain: 'architecture', violation: '```python\n# 20 modules import requests directly; switching to httpx is a 20-file change.\n```', statement: 'Third-party library usage is concentrated in adapter modules. Imports of the library are confined; the rest of the codebase imports the adapter. Swapping the library affects one module, not the codebase.', last_validated: '2026-08-13', category: 'CAT-CODE-ARCH-001', times_seen_positive: 0, _dump_id: 'ARCH-BOUNDARY-002'});
CREATE (:Rule {severity: 'high', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review. Check class hierarchy depth during PR review.', project: 'writ', trigger: 'Class hierarchy depth exceeds 2 levels of project code. Language/framework base classes (`ABC`, `Protocol`, `BaseModel`, `AbstractController`, `AbstractPlugin`) are excluded from the count.', pass_example: '```python\nclass SpecificValidator:\n    def __init__(self, strategy: ValidationStrategy):\n        self._strategy = strategy\n\n    def validate(self, data: dict) -> bool:\n        return self._strategy.validate(data)\n```', rationale: 'Deep inheritance hierarchies create tight coupling, make behavior hard to trace, and resist testing. Composition via injection produces the same polymorphism with explicit, traceable dependencies.', mandatory: false, rule_id: 'ARCH-COMP-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', violation: '```python\nclass SpecificValidator(BaseValidator(AbstractValidator)):\n    # 3 levels of project code -- too deep\n    ...\n```', domain: 'architecture', scope: 'component', statement: 'Class inheritance depth must not exceed 2 levels of project code. Deeper hierarchies must be refactored to use composition via constructor injection.', last_validated: '2026-08-13', category: 'CAT-CODE-ARCH-001', times_seen_positive: 0, _dump_id: 'ARCH-COMP-001'});
CREATE (:Rule {severity: 'medium', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review.', project: 'writ', trigger: 'When passing data between layers (HTTP <-> service, service <-> data access, service <-> external).', pass_example: '```python\n@dataclass\nclass CreateOrderInput:\n    user: UserRef\n    items: list[OrderItem]\n\ndef create_order(input: CreateOrderInput): ...\n```', mandatory: false, rationale: 'Raw dicts hide the contract between layers and propagate typos as runtime errors. DTOs make the contract explicit and machine-checkable.\n\nRelated rules: API-CONTRACT-001, DRY-DUP-003, SEC-VAL-TYPE-001.', rule_id: 'ARCH-DTO-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', domain: 'architecture', violation: '```python\ndef create_order(data: dict):\n    user = data[\'user\']\n    items = data[\'items\']\n    # data shape is implicit; callers must know.\n```', statement: 'Data carriers are explicit DTOs (dataclasses, Pydantic models, Zod schemas, TypeScript types). Raw dicts passed through layers are violations: they lose type information, schema validation, and IDE support.', last_validated: '2026-08-13', category: 'CAT-CODE-ARCH-001', times_seen_positive: 0, _dump_id: 'ARCH-DTO-001'});
CREATE (:Rule {severity: 'medium', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review.', project: 'writ', trigger: 'When implementing behavior that should differ across environments (dev, staging, prod).', pass_example: '```python\ncache_ttl = int(os.environ[\'CACHE_TTL_SECONDS\'])\n# Different .env / config / secret manager per environment.\n```', mandatory: false, rationale: 'Env-name branches couple code to a specific environment topology. Config-driven behavior travels: the same code runs anywhere if the config is right.', rule_id: 'ARCH-ENV-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', domain: 'architecture', violation: '```python\nif os.environ[\'ENV\'] == \'prod\':\n    cache_ttl = 3600\nelse:\n    cache_ttl = 60\n```', statement: 'Environment-specific behavior is controlled by configuration values, not by `if env == \'prod\'` branches in code. Per-environment config files / env vars carry the differences; code reads config, not the environment name.', last_validated: '2026-08-13', category: 'CAT-CODE-ARCH-001', times_seen_positive: 0, _dump_id: 'ARCH-ENV-001'});
CREATE (:Rule {severity: 'medium', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review.', project: 'writ', trigger: 'When two bounded contexts (subdomains, modules with separate responsibilities) need to communicate.', pass_example: '```python\n# orders module:\nevent_bus.publish(OrderPlaced(order_id=order.id, items=order.items))\n# inventory module subscribes to OrderPlaced and reserves.\n```', rationale: 'Direct calls tangle bounded contexts: changes in inventory ripple to orders. Events keep contexts independently deployable and testable.\n\nRelated rules: SCALE-QUEUE-002.', mandatory: false, rule_id: 'ARCH-EVENT-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', violation: '```python\n# orders module:\nfrom inventory import reserve_items  # direct cross-context call\nreserve_items(order.items)\n```', domain: 'architecture', statement: 'Cross-domain communication uses events or messages, not direct method calls between bounded contexts. The sender publishes; the receiver subscribes. Coupling is one-way: events carry data, not references to receivers.', last_validated: '2026-08-13', category: 'CAT-CODE-ARCH-001', times_seen_positive: 0, _dump_id: 'ARCH-EVENT-001'});
CREATE (:Rule {severity: 'medium', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Flag registry with TTL/owner fields. PR template requires sunset date.', project: 'writ', trigger: 'When introducing or removing a feature flag.', pass_example: '```python\n# flags.is_enabled(\'new_billing_flow\')  # owner: @alice; sunset: 2026-08-01\n# After sunset: flag is removed, both branches converged on the winner.\n```', mandatory: false, rationale: 'Eternal feature flags accumulate as branches that never converge. Sunset dates create momentum to remove them.\n\nRelated rules: DRY-CONFIG-002.', rule_id: 'ARCH-FEATURE-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', domain: 'architecture', violation: '```python\n# flags.is_enabled(\'new_billing_flow\')  # added 2 years ago, never removed\n```', statement: 'Feature flags have an explicit expiration date and a documented cleanup plan (who removes the flag, when, and what the cleanup looks like). Permanent feature flags are violations: they accumulate as conditional spaghetti.', last_validated: '2026-08-13', category: 'CAT-CODE-ARCH-001', times_seen_positive: 0, _dump_id: 'ARCH-FEATURE-001'});
CREATE (:Rule {severity: 'high', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review.', project: 'writ', trigger: 'When implementing a write endpoint that creates resources or triggers side effects (charges, emails, notifications).', pass_example: '```python\n@app.post(\'/charge\')\ndef charge():\n    idem_key = request.headers[\'Idempotency-Key\']\n    existing = IdempotencyRecord.find(idem_key)\n    if existing:\n        return existing.response\n    charge_id = stripe.charge(...)\n    IdempotencyRecord.save(idem_key, charge_id)\n    return charge_id\n```', mandatory: false, rationale: 'Retries are universal in distributed systems. Idempotency keys turn \'safe to retry\' from hope into guarantee.\n\nRelated rules: API-IDEMPOTENT-001, ERR-RETRY-001, SCALE-QUEUE-002.', rule_id: 'ARCH-IDEMPOTENT-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', domain: 'architecture', violation: '```python\n@app.post(\'/charge\')\ndef charge():\n    stripe.charge(amount=request.json[\'amount\'], customer=request.json[\'customer\'])\n    return ok()\n# Network retry charges the customer twice.\n```', statement: 'Write endpoints are idempotent: replaying the same request produces the same result, not duplicate side effects. Idempotency is implemented via an idempotency key supplied by the client and stored server-side until expiration.', last_validated: '2026-08-13', category: 'CAT-CODE-ARCH-001', times_seen_positive: 0, _dump_id: 'ARCH-IDEMPOTENT-001'});
CREATE (:Rule {severity: 'high', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review. Module-import linting (eslint import/no-restricted-paths, pylint).', project: 'writ', trigger: 'When designing or modifying multi-layer applications (presentation, service, data-access, infrastructure).', pass_example: '```python\n@app.route(\'/orders\')\ndef list_orders():\n    return order_service.list_for(current_user)\n\nclass OrderService:\n    def list_for(self, user):\n        return self.orders.by_user(user.id)\n```', rationale: 'Layer skipping defeats the purpose of layers: business logic ends up duplicated across controllers, data access ends up scattered, and testing each layer in isolation becomes impossible.', mandatory: false, rule_id: 'ARCH-LAYER-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', violation: '```python\n@app.route(\'/orders\')\ndef list_orders():\n    return Order.query.filter_by(user_id=current_user.id).all()\n# Presentation skipped service and data-access layers.\n```', domain: 'architecture', scope: 'component', statement: 'Layer boundaries are enforced: presentation calls service, service calls data-access. Layers are not skipped (no controller talking directly to the ORM, no data-access calling the service layer). The dependency graph flows in one direction.', last_validated: '2026-08-13', category: 'CAT-CODE-ARCH-001', times_seen_positive: 0, _dump_id: 'ARCH-LAYER-001'});
CREATE (:Rule {severity: 'medium', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review.', project: 'writ', trigger: 'When defining domain models (entities, value objects, aggregates).', pass_example: '```python\n@dataclass\nclass User:\n    id: UserId\n    name: str\n    def is_eligible(self) -> bool: ...\n# UserRepository converts Django Model <-> User dataclass at boundary.\n```', rationale: 'Framework-coupled domain models drag the framework into every test, every reuse, and every refactor. Plain models are portable.\n\nRelated rules: ARCH-LAYER-001, SOLID-DIP-003, SOLID-SRP-003.', mandatory: false, rule_id: 'ARCH-LAYER-002', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', violation: '```python\nfrom django.db import models\nclass User(models.Model):  # framework-coupled\n    name = models.CharField(max_length=255)\n    def is_eligible(self): ...\n```', domain: 'architecture', statement: 'Domain models have no framework imports. Django ORM Model, SQLAlchemy Base, Spring @Entity, Active Record annotations are framework concerns; the domain model is plain data + behavior. Framework types are converted at boundaries.', last_validated: '2026-08-13', category: 'CAT-CODE-ARCH-001', times_seen_positive: 0, _dump_id: 'ARCH-LAYER-002'});
CREATE (:Rule {severity: 'high', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'CI gate that migrations run cleanly against a fresh database. Code review.', project: 'writ', trigger: 'When changing the database schema.', pass_example: '```python\n# alembic/versions/2026_05_10_add_user_avatar.py\ndef upgrade(): op.add_column(\'users\', sa.Column(\'avatar_url\', sa.String()))\ndef downgrade(): op.drop_column(\'users\', \'avatar_url\')\n```', rationale: 'Versioned migrations make schema state reproducible, reviewable, and rollback-able. Manual DDL turns the schema into a folk artifact.\n\nRelated rules: ARCH-MIGRATION-002, SCALE-MIGRATE-001.', mandatory: false, rule_id: 'ARCH-MIGRATION-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', domain: 'architecture', scope: 'component', violation: '```\n# DBA SSH-es into prod and runs `ALTER TABLE users ADD COLUMN ...`\n# No record in version control; schema and code drift.\n```', statement: 'Schema changes use versioned migrations (Alembic, Django migrations, Flyway, Liquibase, Rails migrations, Doctrine migrations). Manual DDL applied to production environments outside the migration system is a violation.', last_validated: '2026-08-13', category: 'CAT-CODE-ARCH-001', times_seen_positive: 0, _dump_id: 'ARCH-MIGRATION-001'});
CREATE (:Rule {severity: 'medium', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review.', project: 'writ', trigger: 'When writing a database migration.', pass_example: '```python\n# Step 1 migration: stop writing legacy_field; deploy.\n# Step 2 migration (later): drop column once confirmed unused.\n# Each step independently reversible.\n```', mandatory: false, rationale: 'Reversible migrations preserve the option to roll back without data loss. Irreversible changes are sometimes necessary but are explicit decisions.\n\nRelated rules: ARCH-MIGRATION-001, PROC-ROLLBACK-001, SCALE-MIGRATE-001.', rule_id: 'ARCH-MIGRATION-002', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', domain: 'architecture', violation: '```python\ndef upgrade(): op.drop_column(\'users\', \'legacy_field\')\ndef downgrade(): pass  # no way to recover the dropped data\n```', statement: 'Migrations are reversible: both up and down are implemented. Irreversible changes (DROP COLUMN with data, DROP TABLE) are documented with the rationale in the migration file. Reversibility supports staged rollouts and incident rollback.', last_validated: '2026-08-13', category: 'CAT-CODE-ARCH-001', times_seen_positive: 0, _dump_id: 'ARCH-MIGRATION-002'});
CREATE (:Rule {severity: 'high', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review.', project: 'writ', trigger: 'When modifying shared mutable state (module-level variables, singletons, in-memory caches, class-level state) from multi-threaded or async code.', pass_example: '```python\nimport threading\nCACHE: dict = {}\nLOCK = threading.Lock()\ndef get_or_compute(key):\n    with LOCK:\n        if key not in CACHE:\n            CACHE[key] = expensive(key)\n        return CACHE[key]\n# Or use functools.lru_cache (thread-safe).\n```', mandatory: false, rationale: 'Unguarded concurrent mutation produces nondeterministic bugs that are nearly impossible to reproduce. Synchronization or immutability removes the entire bug class.\n\nRelated rules: PERF-CACHE-004, TEST-EDGE-003.', rule_id: 'ARCH-STATE-001', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', domain: 'architecture', violation: '```python\nCACHE = {}\ndef get_or_compute(key):\n    if key not in CACHE:\n        CACHE[key] = expensive(key)\n    return CACHE[key]\n# Two threads racing on the same key both run expensive().\n```', statement: 'Shared mutable state is protected by explicit synchronization (locks, mutexes, atomic operations) or replaced by message-passing / immutable updates. Unguarded global mutation in concurrent code is a violation.', last_validated: '2026-08-13', category: 'CAT-CODE-ARCH-001', times_seen_positive: 0, _dump_id: 'ARCH-STATE-001'});
CREATE (:Rule {severity: 'medium', evidence: 'doc:original-bible', confidence: 'production-validated', staleness_window: 365, enforcement: 'Code review. ESLint rule restricting imports of competing libraries. Related: ARCH-DTO-001.', project: 'writ', trigger: 'When introducing state management for application UI.', pass_example: '```\n# Project chose Zustand. All shared state lives in Zustand stores.\n# Local component state is allowed only for non-shared concerns.\n```', mandatory: false, rationale: 'Mixed state-management produces state that lives in multiple places at once and drifts. One pattern is the structural defense.', rule_id: 'ARCH-STATE-002', times_seen_negative: 0, source_origin: 'ingest', provenance: 'hand-authored', authority: 'human', scope: 'component', domain: 'architecture', violation: '```\n# Some components read from Redux, others from Context, others from\n# local useState mirroring shared state. Bugs hide between the mirrors.\n```', statement: 'A single state-management pattern (Redux, Zustand, MobX, React Context, Vuex, Pinia, NgRx) is used per project. Mixing two patterns scatters state across incompatible mental models. The choice is documented and consistent.', last_validated: '2026-08-13', category: 'CAT-CODE-ARCH-001', times_seen_positive: 0, _dump_id: 'ARCH-STATE-002'});
CREATE (:Category {evidence: 'peer-reviewed', confidence: 'peer-reviewed', staleness_window: 365, description: 'Coding rules category.', project: 'writ', trigger: 'Routing metadata for the Coding rules category; not retrievable.', body: '# Category: Coding rules\n\nRouting category `CAT-CODE-001`. Routes: semantic. Parent: (root).', rationale: 'Categories carry routing metadata so retrieval routing is graph data, not hardcoded exclusion (Phase 0 Move-B).', times_seen_negative: 0, source_origin: 'ingest', routes: ['semantic'], provenance: 'hand-authored', category_id: 'CAT-CODE-001', authority: 'human', domain: 'routing', scope: 'global', statement: 'Members of CAT-CODE-001 surface via routes [semantic].', name: 'Coding rules', last_validated: '2026-06-12', times_seen_positive: 0, _dump_id: 'CAT-CODE-001'});
